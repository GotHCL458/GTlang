fn make(n: int) -> list[list[int]] {
    m := list()
    i := 0
    while i < n {
        row := list()
        j := 0
        while j < n { push(row, i * n + j)  j = j + 1 }
        push(m, row)
        i = i + 1
    }
    return m
}
fn mul(a: list[list[int]], b: list[list[int]], n: int) -> list[list[int]] {
    c := list()
    i := 0
    while i < n {
        row := list()
        j := 0
        while j < n {
            s := 0
            k := 0
            while k < n { s = s + a[i][k] * b[k][j]  k = k + 1 }
            push(row, s)
            j = j + 1
        }
        push(c, row)
        i = i + 1
    }
    return c
}
fn main() {
    a := make(3)
    b := make(3)
    c := mul(a, b, 3)
    for row in c { put(row) }
}
