@derive(Ord, Eq, Debug)
struct Person { age: int, name: str }
fn main() {
    a := Person { age: 30, name: "Alice" }
    b := Person { age: 25, name: "Bob" }
    c := Person { age: 35, name: "Carol" }
    put(a < b)
    put(a > b)
    put(a == a)
    ps := list()
    push(ps, a)
    push(ps, b)
    push(ps, c)
    // 按 age 排序
    n := len(ps)
    i := 0
    while i < n {
        j := 0
        while j < n - i - 1 {
            if ps[j].age > ps[j + 1].age {
                t := ps[j]
                ps[j] = ps[j + 1]
                ps[j + 1] = t
            }
            j = j + 1
        }
        i = i + 1
    }
    for p in ps { put(p) }
}
