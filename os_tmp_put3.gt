fn main() {
    // bool 数组
    bs := [true, false, true]
    put(bs)
    // 字符串数组
    ss := ["a", "bb", "ccc"]
    put(ss)
    // 浮点数组
    fs := [1.5, 2.5]
    put(fs)
    // 嵌套 Option
    o1 := Some(1)
    os := list()
    push(os, o1)
    put(os)
    // 空 map
    em := map()
    put(em)
    // 大 list
    big := list()
    i := 0
    while i < 10 { push(big, i)  i = i + 1 }
    put(big)
}
