fn f(n: int) -> Result[int, str] {
    if n < 0 { return Err("neg") }
    return Ok(n)
}
fn describe(r: Result[int, str]) -> str {
    match r {
        Ok(v) if v > 0 => { return "pos" }
        Ok(v) if v == 0 => { return "zero" }
        Ok(v) => { return "neg" }
        Err(e) => { return e }
    }
}
fn main() {
    put(describe(f(5)))
    put(describe(f(0)))
    put(describe(f(-3)))
}
