trait Shape { fn area(self) -> f64 }
struct Circle { r: f64 }
struct Square { s: f64 }
impl Shape for Circle { fn area(self) -> f64 { return 3.14 * self.r * self.r } }
impl Shape for Square { fn area(self) -> f64 { return self.s * self.s } }
fn show_all(xs: list[dyn Shape]) {
    for x in xs { put(x.area()) }
}
fn main() {
    xs := list()
    push(xs, Circle { r: 1.0 })
    push(xs, Square { s: 2.0 })
    show_all(xs)
}
