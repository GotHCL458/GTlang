import string
fn main() {
    // 字符串构建器
    sb := sb_new()
    i := 0
    while i < 10 {
        sb_push_str(sb, str(i))
        sb_push_char(sb, 44)
        i = i + 1
    }
    put(sb_finish(sb))
    // 位运算
    x := 0
    j := 0
    while j < 8 {
        x = x | (1 << j)
        j = j + 1
    }
    put(x)
    put(x & 0xF0)
    put(x ^ 0xFF)
    // 浮点累加
    f := 0.0
    k := 0
    while k < 100 {
        f = f + 0.01
        k = k + 1
    }
    put(f)
}
