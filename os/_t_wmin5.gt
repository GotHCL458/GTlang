fn main() {
    arr := [10, 20, 30]
    i := 0
    while true {
        match (if i < 3 { Some(arr[i]) } else { None }) {
            Some(x) => {
                put(x)
                put(10)
                i = i + 1
            }
            _ => { break }
        }
    }
    put(99)
    put(10)
}
