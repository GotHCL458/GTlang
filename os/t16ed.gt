enum Shape { Circle(int), Square(int) }

fn area(s: Shape) -> int {
    return match s {
        Shape::Circle(r) => { r * r * 3 },
        Shape::Square(w) => { w * w },
    }
}

fn main() {
    a := Shape::Circle(2)
    put(area(a) + 53)
    put(10)
    b := Shape::Square(3)
    put(area(b) + 56)
    put(10)
}
