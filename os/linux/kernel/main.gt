//! 内核主入口
import boot.system
import "console.gt"
import "fs.gt"
import "shell.gt"
import "keyboard.gt"
import "task.gt"

fn main() {
    console.init()
    console.puts("[kernel] GTLang pseudo-Linux booting\n")
    fs.init()
    fs.write("motd", "welcome to GTLang linux")
    keyboard.init()
    shell.run("help")
    shell.run("ls")
    console.puts("[kernel] done\n")
    boot.system.hlt()
}

