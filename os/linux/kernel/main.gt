//! 内核主入口
import boot.system
import "console.gt"
import "fs.gt"
import "shell.gt"
import "keyboard.gt"
import "task.gt"

fn main() {
    console.init()
    console.puts_color("[kernel] GTLang pseudo-Linux booting\n", console.CYAN, console.BLACK)
    fs.init()
    fs.write("motd", "welcome to GTLang linux")
    keyboard.init()
    console.puts_color("welcome! type 'help'\n", console.GREEN, console.BLACK)
    shell.exec_line("help")
    shell.exec_line("ls")
    shell.exec_line("ver")
    shell.repl()
    console.puts("[kernel] done\n")
    boot.system.hlt()
}

