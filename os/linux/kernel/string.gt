//! 字符串工具（多文件模块示例）

pub fn eq(a: str, b: str) -> bool {
    if len(a) != len(b) { return false }
    i := 0
    while i < len(a) {
        if a[i] != b[i] { return false }
        i = i + 1
    }
    return true
}

pub fn starts_with(s: str, prefix: str) -> bool {
    if len(prefix) > len(s) { return false }
    i := 0
    while i < len(prefix) {
        if s[i] != prefix[i] { return false }
        i = i + 1
    }
    return true
}
