//! 控制台：VGA 文本 + 串口双输出
import boot.serial
import boot.screen

pub fn init() {
    boot.serial.init()
    boot.screen.vga_clear()
    boot.screen.vga_set_color(0x0F, 0x00)
    boot.serial.puts("[console] ready\n")
}

pub fn puts(s: str) {
    boot.serial.puts(s)
    boot.screen.vga_puts(s)
}

pub fn putc(c: int) {
    boot.serial.putc(c)
    boot.screen.vga_putc(c)
}

pub fn newline() {
    putc(10)
}

pub fn print_int(n: int) {
    put(n)
    newline()
}

