//! 键盘驱动（GTLang 直接读 PS/2 端口）
import boot.interrupt
import boot.port
import boot.serial
import boot.system
import "console.gt"

pub fn init() {
    boot.interrupt.idt_init()
    boot.interrupt.irq_enable()
    console.puts("[kbd] ready\n")
}

// 扫描码 -> ASCII（简化：字母/数字/常用符号）
pub fn scancode_to_ascii(sc: int) -> int {
    if sc == 0x1E { return 97 }   // a
    if sc == 0x30 { return 98 }   // b
    if sc == 0x2E { return 99 }   // c
    if sc == 0x20 { return 100 }  // d
    if sc == 0x12 { return 101 }  // e
    if sc == 0x21 { return 102 }  // f
    if sc == 0x22 { return 103 }  // g
    if sc == 0x23 { return 104 }  // h
    if sc == 0x17 { return 105 }  // i
    if sc == 0x24 { return 106 }  // j
    if sc == 0x25 { return 107 }  // k
    if sc == 0x26 { return 108 }  // l
    if sc == 0x32 { return 109 }  // m
    if sc == 0x31 { return 110 }  // n
    if sc == 0x18 { return 111 }  // o
    if sc == 0x19 { return 112 }  // p
    if sc == 0x10 { return 113 }  // q
    if sc == 0x13 { return 114 }  // r
    if sc == 0x1F { return 115 }  // s
    if sc == 0x14 { return 116 }  // t
    if sc == 0x16 { return 117 }  // u
    if sc == 0x2F { return 118 }  // v
    if sc == 0x11 { return 119 }  // w
    if sc == 0x2D { return 120 }  // x
    if sc == 0x15 { return 121 }  // y
    if sc == 0x2C { return 122 }  // z
    if sc == 0x39 { return 32 }   // 空格
    if sc == 0x1C { return 10 }   // 回车
    if sc == 0x0E { return 8 }    // 退格
    return -1
}

// 直接轮询 PS/2 端口（0x64 状态 + 0x60 数据）
pub fn poll() -> int {
    c := boot.interrupt.keyboard_handler()
    if c >= 0 { return c }
    st := boot.port.inb(0x64)
    if (st & 1) != 0 {
        sc := boot.port.inb(0x60)
        if sc < 0x80 {
            a := scancode_to_ascii(sc)
            if a >= 0 { return a }
        }
    }
    return -1
}

pub fn wait_key() -> int {
    // 先 PS/2（IRQ1 缓冲 + 轮询端口）；再串口（阻塞读，供终端/管道输入）
    while true {
        c := poll()
        if c >= 0 { return c }
        sc := boot.serial.getc()
        if sc >= 0 { return sc }
    }
    return -1
}

