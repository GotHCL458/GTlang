extern "C" {
    fn boot_serial_init()
    fn boot_serial_puts(s: str)
    fn boot_serial_putc(c: int)
    fn boot_idt_init()
    fn boot_irq_enable()
    fn boot_keyboard_handler() -> int
    fn boot_hlt()
}

fn main() {
    boot_serial_init()
    boot_serial_puts("init idt...\n")
    boot_idt_init()
    boot_serial_puts("idt done, enabling irq...\n")
    boot_irq_enable()
    boot_serial_puts("irq on, polling keys:\n")
    i := 0
    while i < 50000000 {
        c := boot_keyboard_handler()
        if c >= 0 {
            boot_serial_puts("key=")
            boot_serial_putc(c)
            boot_serial_putc(10)
        }
        i = i + 1
    }
    boot_serial_puts("timeout\n")
    boot_hlt()
}
