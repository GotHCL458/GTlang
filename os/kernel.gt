import boot

fn main() {
    boot.serial_init()
    boot.serial_puts("[gtlang] cpu + rtc\n")
    buf := boot.mem_alloc(64)
    boot.cpu_vendor(buf)
    boot.serial_puts("vendor ok\n")
    tbuf := boot.mem_alloc(16)
    boot.rtc_read(tbuf)
    boot.serial_puts("rtc ok\n")
    pbuf := boot.mem_alloc(64)
    n := boot.disk_partitions(pbuf)
    boot.serial_puts("partitions rc=")
    put(n)
    put(10)
    boot.hlt()
}
