import boot

fn main() {
    boot.serial_init()
    boot.serial_puts("[gtlang] paging + irq\n")
    pg := boot.mem_alloc(0x3000)
    rc := boot.paging_init(pg)
    boot.serial_puts("paging rc=")
    put(rc)
    put(10)
    freeb := boot.mem_free_bytes()
    boot.serial_puts("free bytes ok\n")
    boot.irq_register(0, 0)
    boot.serial_puts("irq register ok\n")
    boot.hlt()
}
