import boot

fn main() {
    boot.serial_init()
    boot.serial_puts("[gtlang] vga + fs\n")
    boot.vga_clear()
    boot.vga_set_color(0x0E, 0x01)
    boot.vga_puts("GTLang VGA works")
    boot.serial_puts("vga ok\n")
    boot.fs_ram.write("t.txt", "abc", 3)
    boot.serial_puts("fs count=")
    put(boot.fs_ram.count())
    put(10)
    boot.hlt()
}
