trait Greeter {
    fn greet(self) -> str { return "Hello, " + self.name() }
    fn name(self) -> str
}
struct Person { n: str }
impl Greeter for Person {
    fn name(self) -> str { return self.n }
}
struct Robot { id: int }
impl Greeter for Robot {
    fn name(self) -> str { return "R" + str(self.id) }
    fn greet(self) -> str { return "Beep: " + self.name() }
}
fn main() {
    put(Person { n: "Alice" }.greet())
    put(Robot { id: 7 }.greet())
}
