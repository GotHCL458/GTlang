enum E { Wrap(Result[int, str]) Empty }
fn f(n: int) -> E {
    if n < 0 { return E::Wrap(Err("neg")) }
    return E::Wrap(Ok(n))
}
fn main() {
    match f(5) {
        E::Wrap(Ok(v)) => { put(v) }
        E::Wrap(Err(e)) => { put(e) }
        E::Empty => { put("empty") }
    }
    match f(-1) {
        E::Wrap(Ok(v)) => { put(v) }
        E::Wrap(Err(e)) => { put(e) }
        E::Empty => { put("empty") }
    }
}
