fn step1(n: int) -> Result[int, str] {
    if n < 0 { return Err("step1 neg") }
    return Ok(n + 1)
}
fn step2(n: int) -> Result[int, str] {
    if n > 100 { return Err("step2 too big") }
    return Ok(n * 2)
}
fn pipeline(n: int) -> Result[int, str] {
    a := step1(n)?
    b := step2(a)?
    return Ok(b)
}
fn main() {
    match pipeline(5) { Ok(v) => { put(v) } Err(e) => { put(e) } }
    match pipeline(-1) { Ok(v) => { put(v) } Err(e) => { put(e) } }
    match pipeline(200) { Ok(v) => { put(v) } Err(e) => { put(e) } }
}
