fn main() {
    // for-else
    found := false
    for i in 0..5 {
        if i == 3 { found = true  break }
    } else {
        put("not found")
    }
    put(found)
    // 标签循环
    outer: for i in 0..3 {
        for j in 0..3 {
            if j == 1 { break outer }
            put(i * 10 + j)
        }
    }
    // loop N
    loop 2 { put("x") }
}
