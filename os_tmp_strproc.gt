fn reverse(s: str) -> str {
    chars := list()
    for ch in s { push(chars, ch) }
    r := ""
    i := len(chars) - 1
    while i >= 0 {
        r = r + chars[i]
        i = i - 1
    }
    return r
}
fn is_palindrome(s: str) -> bool {
    return s == reverse(s)
}
fn count_char(s: str, c: str) -> int {
    n := 0
    for ch in s { if ch == c { n = n + 1 } }
    return n
}
fn main() {
    put(reverse("hello"))
    put(is_palindrome("racecar"))
    put(is_palindrome("hello"))
    put(count_char("banana", "a"))
    put(count_char("banana", "n"))
}
