struct Node { val: int, next: int }
fn 累加(n: int) -> int {
    if n <= 0 { return 0 }
    return n + 累加(n - 1)
}
fn main() {
    put(累加(10))
    a := list()
    b := list()
    c := list()
    push(c, 1)
    push(c, 2)
    push(b, c)
    push(a, b)
    put(a)
    nodes := list()
    i := 0
    while i < 3 {
        push(nodes, Node { val: i, next: i + 1 })
        i = i + 1
    }
    put(nodes)
}
