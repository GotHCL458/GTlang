fn parse_positive(s: str) -> Result[int, str] {
    n := int(s)
    if n <= 0 { return Err("not positive: " + s) }
    return Ok(n)
}
fn sum_three(a: str, b: str, c: str) -> Result[int, str] {
    x := parse_positive(a)?
    y := parse_positive(b)?
    z := parse_positive(c)?
    return Ok(x + y + z)
}
fn main() {
    put(sum_three("1", "2", "3"))
    put(sum_three("1", "-2", "3"))
    // try/expt
    try {
        r := sum_three("10", "20", "30")?
        put(r)
    } expt e {
        put("caught: " + e)
    }
    // Option 链
    o := Some(5)
    if let Some(v) = o { put(v * 2) } else { put(0) }
}
