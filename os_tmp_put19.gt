fn f(n: int) -> Result[int, str] {
    if n == 0 { return Err("zero") }
    return Ok(100 / n)
}
fn g(n: int) -> Result[int, str] {
    v := f(n)?
    return Ok(v + 1)
}
fn main() {
    match g(5) {
        Ok(v) => { put(v) }
        Err(e) => { put(e) }
    }
    match g(0) {
        Ok(v) => { put(v) }
        Err(e) => { put("err: " + e) }
    }
}
