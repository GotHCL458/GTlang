struct Cons { head: int, tail: Option[int] }
fn sum_cons(xs: list[Cons]) -> int {
    s := 0
    for c in xs {
        s = s + c.head
        if let Some(t) = c.tail { s = s + t }
    }
    return s
}
fn main() {
    xs := list()
    push(xs, Cons { head: 1, tail: Some(10) })
    push(xs, Cons { head: 2, tail: Some(20) })
    push(xs, Cons { head: 3, tail: None })
    put(sum_cons(xs))
    // 遍历输出
    for c in xs {
        match c.tail {
            Some(t) => { put(str(c.head) + " -> " + str(t)) }
            None => { put(str(c.head) + " -> nil") }
        }
    }
}
