fn fib(n: int) -> int {
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}
fn 求和(n: int) -> int {
    s := 0
    i := 0
    while i < n { s = s + i  i = i + 1 }
    return s
}
fn 列表(n: int) -> int {
    a := list()
    i := 0
    while i < n { push(a, i)  i = i + 1 }
    s := 0
    j := 0
    while j < n { s = s + a[j]  j = j + 1 }
    return s
}
fn main() {
    put(fib(32))
    put(求和(20000000))
    put(列表(2000000))
}