fn main() {
    o := Some(Ok(42))
    match o {
        Some(Ok(v)) => { put(v) }
        Some(Err(e)) => { put(e) }
        None => { put("none") }
    }
    // 嵌套 Some(Some(v))
    p := Some(Some(7))
    match p {
        Some(Some(v)) => { put(v) }
        Some(None) => { put("inner none") }
        None => { put("outer none") }
    }
}
