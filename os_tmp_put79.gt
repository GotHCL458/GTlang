enum Shape { Circle(f64) Square(f64) }
enum E { Has(Shape) Empty }
fn main() {
    a := E::Has(Shape::Circle(3.14))
    match a {
        E::Has(s) => {
            match s {
                Shape::Circle(r) => { put(r) }
                Shape::Square(x) => { put(x) }
            }
        }
        E::Empty => { put("empty") }
    }
}
