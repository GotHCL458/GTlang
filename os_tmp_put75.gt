fn f(n: int) -> Option[int] {
    if n > 0 { return Some(n) }
    return None
}
fn describe(o: Option[int]) -> str {
    match o {
        Some(v) => { return "some:" + int_str(v) }
        None => { return "none" }
    }
}
fn int_str(n: int) -> str { return str(n) }
fn main() {
    put(describe(f(5)))
    put(describe(f(-1)))
}
