struct A { v: int }
struct B { a: A, b: A }
struct C { b: B, tag: str }
fn main() {
    c := C { b: B { a: A { v: 1 }, b: A { v: 2 } }, tag: "deep" }
    put(c)
    // 嵌套 list of struct
    ps := list()
    push(ps, A { v: 10 })
    push(ps, A { v: 20 })
    put(ps)
    // 多层 map
    m := map()
    m[1] = 100
    m[2] = 200
    m[3] = 300
    put(m)
    // 混合容器
    mix := list()
    push(mix, 1)
    push(mix, "two")
    put(mix)
}
