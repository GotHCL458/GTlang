fn bubble_sort(xs: list[int]) {
    n := len(xs)
    i := 0
    while i < n {
        j := 0
        while j < n - i - 1 {
            if xs[j] > xs[j + 1] {
                tmp := xs[j]
                xs[j] = xs[j + 1]
                xs[j + 1] = tmp
            }
            j = j + 1
        }
        i = i + 1
    }
}
fn bsearch(xs: list[int], target: int) -> int {
    lo := 0
    hi := len(xs) - 1
    while lo <= hi {
        mid := (lo + hi) / 2
        if xs[mid] == target { return mid }
        if xs[mid] < target { lo = mid + 1 } else { hi = mid - 1 }
    }
    return -1
}
fn main() {
    xs := list()
    push(xs, 5)
    push(xs, 2)
    push(xs, 8)
    push(xs, 1)
    push(xs, 9)
    push(xs, 3)
    bubble_sort(xs)
    put(xs)
    put(bsearch(xs, 5))
    put(bsearch(xs, 9))
    put(bsearch(xs, 7))
}
