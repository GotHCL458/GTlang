fn classify(n: int) -> str {
    match n {
        0 => { return "zero" }
        1 | 2 | 3 => { return "small" }
        4..10 => { return "medium" }
        x if x < 0 => { return "negative" }
        _ => { return "large" }
    }
}
fn main() {
    put(classify(0))
    put(classify(2))
    put(classify(7))
    put(classify(-5))
    put(classify(100))
}
