trait Show { fn show(self) -> str }
struct Cat { name: str }
struct Dog { name: str }
impl Show for Cat { fn show(self) -> str { return "cat: " + self.name } }
impl Show for Dog { fn show(self) -> str { return "dog: " + self.name } }
fn main() {
    c := Cat { name: "Tom" }
    d := Dog { name: "Rex" }
    put(c.show())
    put(d.show())
    // 结构体本身 put
    put(c)
    put(d)
}
