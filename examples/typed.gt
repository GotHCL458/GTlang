// 类型注解、类型转换内置、编译期类型检查
//
// 这个示例里每个变量/参数/返回值都带显式类型注解，
// 编译期（sema + type.rs）会逐一核对；注解与实际类型不符会直接报错。

const 圆周率: f64 = 3.14159265358979
const 上限: int = 100

// 参数与返回值都带注解
fn 面积(半径: f64) -> f64 {
    圆周率 * 半径 * 半径
}

fn 累加(到: int) -> int {
    和 := 0
    for i in 1..(到 + 1) {
        和 = 和 + i
    }
    和
}

fn 标签(名: str, 值: int) -> str {
    "$名 = $值"
}

fn 判定(分: int) -> str {
    if 分 >= 90 {
        "优秀"
    } else if 分 >= 60 {
        "及格"
    } else {
        "不及格"
    }
}

fn main() {
    put("=== 类型注解 ===")
    let 半径: f64 = 2.0
    put("圆面积(半径 ${半径}) = ${面积(半径)}")
    put("累加(${上限}) = ${累加(上限)}")
    put(标签("计数", 42))
    put(标签("分数", 95))
    put("95 → ${判定(95)}，72 → ${判定(72)}，30 → ${判定(30)}")

    // 整数会自动拓宽为浮点（type.rs 的 is_assignable）
    let 隐式提升: f64 = 3
    put("整数 3 赋给 f64 变量 = ${隐式提升}")

    put("=== 类型转换 ===")
    let 整数: int = 255
    let 小数: f64 = 3.7
    let 真值: bool = true
    let 数字串: str = "1234"
    put("str(255) = ${str(整数)}")
    put("str(3.7) = ${str(小数)}")
    put("str(true) = ${str(真值)}")
    put("int(\"1234\") = ${int(数字串)}")
    put("int(3.7) = ${int(小数)}   ← 截断")
    put("f64(255) = ${f64(整数)}")
    put("bool(255) = ${bool(整数)}，bool(0) = ${bool(0)}")
    put("bool(\"\") = ${bool(\"\")}，bool(\"x\") = ${bool(\"x\")}")
    put("int(\"12abc\") = ${int(\"12abc\")}   ← 只解析数字前缀")
    put("int(\"-77\") = ${int(\"-77\")}，f64(\"2.5e2\") = ${f64(\"2.5e2\")}")

    // 转换结果参与运算，类型由 type.rs 推导
    let 总价: f64 = f64(int(数字串)) * 1.5
    put("int→f64→*1.5 = ${总价}")
    put("str(总价) = ${str(总价)}")

    put("=== 浮点格式与编译器一致 ===")
    put("1.0 / 3.0 = ${1.0 / 3.0}")
    put("100000.0 = ${100000.0}，0.0001 = ${0.0001}")
    put("1000000.0 = ${1000000.0}")
}