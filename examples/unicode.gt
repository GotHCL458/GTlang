// 多编码输出适配：中文 / 日文 / 韩文 / 俄文 / 泰文 / 符号 / emoji
// 控制台走 WriteConsoleW(UTF-16)，绕过代码页；重定向时输出标准 UTF-8
fn main() {
    put("简体中文：你好，世界！")
    put("繁體中文：你好，世界！")
    put("日本語：こんにちは、世界！")
    put("한국어：안녕하세요, 세계!")
    put("Русский：Привет, мир!")
    put("ไทย：สวัสดีชาวโลก")
    put("符号：★☆ ♪♫ ← ↑ → ↓ √ ∞ ≠ ≤ ≥")
    put("emoji：😀  🚀 👍 🌏")

    // 插值与多编码混排
    名字 := "世界"
    数 := 42
    put("插值混排：【${名字}】× ${数} → 😀")
    put("浮点：π ≈ ${3.14159}，日文数字：${数}")

    // 中日韩混排同一行
    put("混排：中文·日本語·한국어·English·123")
}