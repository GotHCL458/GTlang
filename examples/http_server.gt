import json
import web

// 一个功能完整的网页服务器（基于标准库 web 模块）
// 运行： gtc --run examples/http_server.gt
// 浏览器访问本地 8080 端口

fn 首页() -> str {
    return "<h1>GTLang 服务器</h1><p>请访问 <a href=\"/static/index.html\">/static/index.html</a></p>"
}

fn 接口() -> str {
    return json_object("ok=" + json_bool(1) + ";lang=" + json_escape("GTLang"))
}

fn 问候页() -> str {
    return html_page("问候", "<h1>你好，{{param:name}}！</h1><p>这是动态路由注入的参数。</p>")
}

fn 回显页() -> str {
    return html_page("回显", "<h1>收到请求体</h1><pre>{{body}}</pre>")
}

fn 创建页() -> str {
    return json_object("created=" + json_bool(1))
}

fn 请求头页() -> str {
    body := "<h1>请求头</h1><ul>" +
            "<li>User-Agent: {{header:User-Agent}}</li>" +
            "<li>Host: {{header:Host}}</li></ul>"
    return html_page("请求头", body)
}

fn 计数页() -> str {
    return html_page("Cookie 计数", "<h1>Cookie 演示</h1><p>上次计数：{{cookie:count}}</p>")
}

fn main() {
    routes :=
        "GET / =" + 首页() + "\n" +
        "GET /api/time =" + 接口() + "\n" +
        "GET /hello/:name =" + 问候页() + "\n" +
        "POST /echo =" + 回显页() + "\n" +
        "POST /api/create ={201}{Content-Type: application/json}" + 创建页() + "\n" +
        "GET /headers =" + 请求头页() + "\n" +
        "GET /count =" + 计数页() + "\n" +
        "GET /static/* =@dir:examples/static\n" +
        "ANY / =未找到该页面"
    put("服务器已启动，监听 8080 端口（Ctrl+C 停止）")
    put("请访问 http://127.0.0.1:8080/static/index.html")
    serve(8080, routes)
}