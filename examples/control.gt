// 控制流、数组、区间迭代、break/continue
fn main() {
    // if 作为表达式
    x := -5
    sign := if x > 0 { 1 } else if x < 0 { -1 } else { 0 }
    put("sign = ${sign}")

    // for 区间
    sum := 0
    for i in 1..11 {
        sum = sum + i
    }
    put("1..10 求和 = ${sum}")

    // 数组 + for-each
    arr := [10, 20, 30]
    total := 0
    for v in arr {
        total = total + v
    }
    put("arr 求和 = ${total}，len(arr) = ${len(arr)}")
    put("arr[1] = ${arr[1]}")

    // break / continue
    n := 0
    for i in 0..100 {
        if i % 2 == 0 { continue }
        if i > 9 { break }
        n = n + i
    }
    put("10 以内奇数之和 = ${n}")

    // 复合赋值
    c := 5
    c += 3
    c *= 2
    put("c = ${c}")
}