// 字符串能力演示：$ 插值 / 转义符 / 原始字符串 / 彩色输出
//
// 插值：$name 简写、${expr} 通用形式；字面 $ 写成 \$
// 转义：\n \t \r \0 \e(ESC) \\ \" \$ 
// 原始：r"..." 不解转义、不做插值
// 彩色：直接用 \e[..m 转义；控制台会自动开启 VT 支持

// 常用 ANSI 片段
const 红   = "\e[31m"
const 绿   = "\e[32m"
const 黄   = "\e[33m"
const 蓝   = "\e[34m"
const 青   = "\e[36m"
const 粗   = "\e[1m"
const 斜   = "\e[3m"
const 下划 = "\e[4m"
const 反白 = "\e[7m"
const 重置 = "\e[0m"

fn main() {
    put("默认颜色")

    put("单一颜色：")
    put("  ${红}红色文字${重置}")
    put("  ${绿}绿色文字${重置}")
    put("  ${黄}黄色文字${重置}")
    put("  ${蓝}蓝色文字${重置}")
    put("  ${青}青色文字${重置}")

    put("样式：")
    put("  ${粗}加粗${重置}  ${下划}下划线${重置}  ${反白}反白${重置}  ${斜}斜体${重置}")

    put("组合：")
    put("  ${粗}${红}粗体+红色${重置}")
    put("  ${下划}${绿}下划线+绿色${重置}")

    put("插值与变量：")
    名字 := "世界"
    分 := 95
    等级 := if 分 >= 90 { "${绿}优秀${重置}" } else { "${红}待提高${重置}" }
    put("  你好 ${粗}${名字}${重置}，得分 $分 → $等级")

    put("转义符：")
    put("  换行→\n中间 制表→\t←结束")
    put("  美元符号字面量：\$分   ← 原样输出 \$分，分 没有被代入")
    put("  反斜杠字面量：\\")

    put("原始字符串 r\"...\"（不解转义、不插值）：")
    put(r"  \n 原样输出，$名字 也不插值")
}