// 运算符与类型：整数 / 浮点 / 布尔 / 字符串 / 常量
const 版本 = "0.1.0"
const MAX: i64 = 100

fn 平均(总分: f64, 个数: f64) -> f64 {
    总分 / 个数
}

fn main() {
    a := 17
    b := 5
    put("${a} + ${b} = ${a + b}")
    put("${a} - ${b} = ${a - b}")
    put("${a} * ${b} = ${a * b}")
    put("${a} / ${b} = ${a / b}   (整除)")
    put("${a} % ${b} = ${a % b}")
    put("${a} // ${b} = ${a//b}   (整除同 /)")

    // 浮点与混合运算
    f := 3.5
    put("f = ${f}，f * 2 = ${f * 2}")
    put("平均(85.0, 4.0) = ${平均(85.0, 4.0)}")

    // 比较与逻辑
    put("a > b = ${a > b}，a == b = ${a == b}，a != b = ${a != b}")
    put("(a > b) && (b > 0) = ${(a > b) && (b > 0)}")
    put("!false = ${!false}")

    // 字符串比较与长度
    s := "GTLang"
    put("s = ${s}，len(s) = ${len(s)}")

    // 常量
    put("版本 = ${版本}，MAX = ${MAX}，MAX * 2 = ${MAX * 2}")
    put("一元负号 = ${-a}")
}