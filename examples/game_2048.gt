// 2048 (interactive CLI)
// Controls: 1=left 2=right 3=up 4=down 0=quit
fn make(w: int) -> list {
    b := list()
    for i in 0..(w * w) { push(b, 0) }
    return b
}

fn idx(w: int, x: int, y: int) -> int { return y * w + x }
fn put_cell(board: list, w: int, x: int, y: int, v: int) { board[idx(w, x, y)] = v }
fn get(board: list, w: int, x: int, y: int) -> int { return board[idx(w, x, y)] }

fn slide_left(vals: list) -> list {
    out := list()
    for v in vals { if v != 0 { push(out, v) } }
    while len(out) < 4 { push(out, 0) }
    i := 0
    while i < 3 {
        if out[i] != 0 && out[i] == out[i + 1] {
            out[i] = out[i] * 2
            out[i + 1] = 0
            i = i + 2
        } else {
            i = i + 1
        }
    }
    res := list()
    for v in out { if v != 0 { push(res, v) } }
    while len(res) < 4 { push(res, 0) }
    return res
}

fn reverse(row: list) -> list {
    r := list()
    i := len(row) - 1
    while i >= 0 { push(r, row[i]) i = i - 1 }
    return r
}

fn transpose(board: list, w: int) -> list {
    nb := make(w)
    for y in 0..w { for x in 0..w { put_cell(nb, w, y, x, get(board, w, x, y)) } }
    return nb
}

fn move_left(board: list, w: int) -> list {
    nb := make(w)
    for y in 0..w {
        row := list()
        for x in 0..w { push(row, get(board, w, x, y)) }
        s := slide_left(row)
        for x in 0..w { put_cell(nb, w, x, y, s[x]) }
    }
    return nb
}

fn move_right(board: list, w: int) -> list {
    nb := make(w)
    for y in 0..w {
        row := list()
        for x in 0..w { push(row, get(board, w, x, y)) }
        s := reverse(slide_left(reverse(row)))
        for x in 0..w { put_cell(nb, w, x, y, s[x]) }
    }
    return nb
}

fn move_up(board: list, w: int) -> list {
    return transpose(move_left(transpose(board, w), w), w)
}

fn move_down(board: list, w: int) -> list {
    return transpose(move_right(transpose(board, w), w), w)
}

fn render(board: list, w: int) {
    put("")
    for y in 0..w {
        row := ""
        for x in 0..w {
            v := get(board, w, x, y)
            if v == 0 { row = "${row}    ." } else { row = "${row}${pad_left(str(v), 5)}" }
        }
        put(row)
    }
}

fn has_moves(board: list, w: int) -> bool {
    for v in board { if v == 0 { return true } }
    return false
}

fn main() {
    w := 4
    b := make(w)
    put_cell(b, w, 0, 0, 2)
    put_cell(b, w, 1, 0, 2)
    put_cell(b, w, 2, 0, 4)
    put_cell(b, w, 3, 0, 4)
    put_cell(b, w, 1, 1, 2)
    put_cell(b, w, 2, 1, 2)
    put_cell(b, w, 0, 2, 8)
    put_cell(b, w, 3, 3, 2)

    put("=== 2048 (bate) ===")
    put("1=left 2=right 3=up 4=down 0=quit")
    render(b, w)
    while true {
        put("move?")
        d := read_int()
        if d == 0 { break }
        if d == 1 { b = move_left(b, w) }
        elif d == 2 { b = move_right(b, w) }
        elif d == 3 { b = move_up(b, w) }
        elif d == 4 { b = move_down(b, w) }
        render(b, w)
        if !has_moves(b, w) { put("no empty cells") break }
    }
    put("bye")
}
