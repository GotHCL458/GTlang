// 完整的用户系统：注册 + 登录 + 后台（基于 web + sql）
// 运行： gtc --run examples/login_app.gt
// 浏览器访问本地 8081 端口
import web
import sql
import string
import crypto

// ---------- 工具：HTML 页面骨架 ----------
fn 页面(标题: str, 内容: str) -> str {
    head := "<!DOCTYPE html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\">" +
            "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">" +
            "<title>" + 标题 + "</title><style>" +
            "body{font-family:system-ui,sans-serif;max-width:520px;margin:48px auto;padding:0 16px;color:#1e293b}" +
            "h1{color:#2563eb}input{display:block;width:100%;box-sizing:border-box;font:inherit;padding:10px 12px;margin:8px 0;border:1px solid #cbd5e1;border-radius:8px}" +
            "button{font:inherit;padding:10px 16px;border-radius:8px;border:none;background:#2563eb;color:#fff;cursor:pointer}" +
            "a{color:#2563eb}table{width:100%;border-collapse:collapse;margin-top:12px}td,th{border:1px solid #e2e8f0;padding:8px;text-align:left}" +
            ".err{color:#dc2626;margin:8px 0}.ok{color:#16a34a;margin:8px 0}" +
            "</style></head><body>"
    return head + 内容 + "</body></html>"
}

// ---------- 工具：解析表单 / Cookie ----------
fn 取表单(body: str, key: str) -> str {
    kv := parse_query(body)
    return url_decode(query_get(kv, key))
}

fn 取Cookie(req: str, key: str) -> str {
    // 请求头在 "---HEADERS---" 之后
    parts := split(req, "---HEADERS---")
    if len(parts) < 2 { return "" }
    lines := split(parts[1], "\n")
    i := 0
    while i < len(lines) {
        line := trim(lines[i])
        low := lower(line)
        if startswith(low, "cookie:") {
            val := trim(substr(line, 7, len(line) - 7))
            return url_decode(query_get(parse_query(replace_all(val, "; ", "&")), key))
        }
        i = i + 1
    }
    return ""
}

// ---------- 工具：SQL 字符串转义 ----------
fn sql转义(s: str) -> str {
    return replace_all(s, "'", "''")
}

// ---------- 数据层 ----------
fn 初始化(db: int) {
    sql_exec(db, "CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY AUTOINCREMENT, username TEXT UNIQUE, password TEXT, created TEXT DEFAULT CURRENT_TIMESTAMP)")
    // 默认管理员
    n := sql_query(db, "SELECT COUNT(*) FROM users WHERE username='admin'")
    if contains(n, "0") {
        h := password_hash("admin123", "adminsalt")
        sql_exec(db, "INSERT OR IGNORE INTO users (username, password) VALUES ('admin', '" + h + "')")
    }
}

fn 验证用户(db: int, user: str, pwd: str) -> int {
    q := "SELECT password FROM users WHERE username='" + sql转义(user) + "'"
    rows := sql_query(db, q)
    lines := split(rows, "\n")
    if len(lines) < 2 || len(lines[1]) == 0 { return 0 }
    stored := lines[1]
    if password_verify(pwd, stored) { return 1 }
    return 0
}

// ---------- 页面 ----------
fn 登录页(消息: str) -> str {
    c := "<h1>登录</h1>" + 消息 +
         "<form method=\"post\" action=\"/login\">" +
         "<input name=\"username\" placeholder=\"用户名\" autocomplete=\"off\" required>" +
         "<input name=\"password\" type=\"password\" placeholder=\"密码\" required>" +
         "<button type=\"submit\">登录</button></form>" +
         "<p>还没有账号？<a href=\"/register\">去注册</a></p>"
    return 页面("登录", c)
}

fn 注册页(消息: str) -> str {
    c := "<h1>注册</h1>" + 消息 +
         "<form method=\"post\" action=\"/register\">" +
         "<input name=\"username\" placeholder=\"用户名\" autocomplete=\"off\" required>" +
         "<input name=\"password\" type=\"password\" placeholder=\"密码\" required>" +
         "<button type=\"submit\">注册</button></form>" +
         "<p>已有账号？<a href=\"/login\">去登录</a></p>"
    return 页面("注册", c)
}

fn 后台页(db: int, 当前用户: str) -> str {
    rows := sql_query(db, "SELECT id, username, created FROM users ORDER BY id")
    lines := split(rows, "\n")
    trs := ""
    i := 1
    while i < len(lines) {
        line := lines[i]
        if len(line) > 0 {
            cols := split(line, "\t")
            if len(cols) >= 3 {
                trs = trs + "<tr><td>" + cols[0] + "</td><td>" + html_escape(cols[1]) + "</td><td>" + cols[2] + "</td></tr>"
            }
        }
        i = i + 1
    }
    c := "<h1>后台管理</h1><p>欢迎，" + html_escape(当前用户) + " · <a href=\"/logout\">退出</a></p>" +
         "<table><tr><th>ID</th><th>用户名</th><th>注册时间</th></tr>" + trs + "</table>"
    return 页面("后台", c)
}

// ---------- 处理函数 ----------
fn 处理(req: str) -> str {
    head := split(req, "\n")
    first := head[0]
    seg := split(first, " ")
    method := seg[0]
    path := seg[1]
    body := ""
    if len(head) >= 2 { body = head[1] }

    db := sql_open("users.db")
    if db == 0 { return "500 Internal Server Error" }
    初始化(db)

    当前用户 := 取Cookie(req, "user")

    // 首页 → 按登录状态跳转
    if path == "/" {
        if len(当前用户) > 0 { return "{303}{Location: /admin}" }
        return "{303}{Location: /login}"
    }

    if path == "/login" && method == "GET" {
        sql_close(db)
        return 登录页("")
    }
    if path == "/register" && method == "GET" {
        sql_close(db)
        return 注册页("")
    }
    if path == "/logout" {
        sql_close(db)
        return "{303}{Set-Cookie: user=; Max-Age=0}{Location: /login}"
    }

    if path == "/login" && method == "POST" {
        u := 取表单(body, "username")
        p := 取表单(body, "password")
        if len(u) == 0 || len(p) == 0 {
            sql_close(db)
            return 登录页("<p class=\"err\">用户名和密码不能为空</p>")
        }
        if 验证用户(db, u, p) == 1 {
            sql_close(db)
            return "{303}{Set-Cookie: user=" + url_encode(u) + "; Path=/; HttpOnly}{Location: /admin}"
        }
        sql_close(db)
        return 登录页("<p class=\"err\">用户名或密码错误</p>")
    }

    if path == "/register" && method == "POST" {
        u := 取表单(body, "username")
        p := 取表单(body, "password")
        if len(u) == 0 || len(p) == 0 {
            sql_close(db)
            return 注册页("<p class=\"err\">用户名和密码不能为空</p>")
        }
        // 查重
        exist := sql_query(db, "SELECT id FROM users WHERE username='" + sql转义(u) + "'")
        if len(split(exist, "\n")) >= 2 && len(split(exist, "\n")[1]) > 0 {
            sql_close(db)
            return 注册页("<p class=\"err\">用户名已存在</p>")
        }
        salt := random_hex(8)
        h := password_hash(p, salt)
        sql_exec(db, "INSERT INTO users (username, password) VALUES ('" + sql转义(u) + "', '" + sql转义(h) + "')")
        sql_close(db)
        return 注册页("<p class=\"ok\">注册成功！<a href=\"/login\">去登录</a></p>")
    }

    if path == "/admin" {
        if len(当前用户) == 0 {
            sql_close(db)
            return "{303}{Location: /login}"
        }
        page := 后台页(db, 当前用户)
        sql_close(db)
        return page
    }

    sql_close(db)
    return "404 Not Found"
}

fn main() {
    put("用户系统已启动：请访问本地 8081 端口")
    put("默认管理员：admin / admin123")
    serve_fn(8081, 处理)
}