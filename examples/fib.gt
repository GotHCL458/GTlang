// 函数、递归、while 循环、尾表达式返回值
fn fib(n) {
    if n < 2 { return n }
    fib(n - 1) + fib(n - 2)     # 块尾表达式即返回值
}

fn 阶乘(n: i64) -> i64 {
    if n <= 1 { return 1 }
    n * 阶乘(n - 1)
}

fn main() {
    put("fib(10) = ${fib(10)}")
    put("阶乘(10) = ${阶乘(10)}")

    // 迭代版：a/b 交换
    a := 0
    b := 1
    i := 0
    while i < 10 {
        t := a + b
        a = b
        b = t
        i = i + 1
    }
    put("循环 fib(10) = ${a}")
}