fn min_val(a: i32, b: i32): i32
{
	if (a < b) {
		return a
	}
	return b
}

fn max_val(a: i32, b: i32): i32
{
	if (a > b) {
		return a
	}
	return b
}

fn main(): i32
{
	print(min_val(3, 7))
	print(min_val(10, 2))
	print(min_val(5, 5))
	print(max_val(3, 7))
	print(max_val(10, 2))
	print(max_val(5, 5))
	return 0
}
