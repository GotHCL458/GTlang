fn is_prime(n: i32): i32 {
    if (n < 2) { return 0 }
    if (n == 2) { return 1 }
    if (n % 2 == 0) { return 0 }
    let mut i = 3
    while (i * i <= n) {
        if (n % i == 0) { return 0 }
        i = i + 2
    }
    return 1
}
fn main(): i32 {
    for (i in 0 .. 20) {
        if (is_prime(i) == 1) { print(i) }
    }
    return 0
}
