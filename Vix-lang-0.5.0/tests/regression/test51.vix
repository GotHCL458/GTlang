fn main(): i32
{
	let mut arr = [5, 3, 8, 1, 9, 2, 7, 4, 6]
	let n = arr.length

	let mut i = 0
	while (i < n - 1)
	{
		let mut j = 0
		while (j < n - 1 - i)
		{
			if (arr[j] > arr[j + 1])
			{
				let tmp = arr[j]
				arr[j] = arr[j + 1]
				arr[j + 1] = tmp
			}
			j += 1
		}
		i += 1
	}

	for (v in arr)
	{
		print(v)
	}

	return 0
}
