fn is_palindrome(n: i32): i32
{
	let mut reversed = 0
	let mut temp = n
	while (temp > 0) {
		reversed = reversed * 10 + temp % 10
		temp = temp / 10
	}
	if (reversed == n) {
		return 1
	}
	return 0
}

fn main(): i32
{
	print(is_palindrome(121))
	print(is_palindrome(123))
	print(is_palindrome(1))
	print(is_palindrome(1221))
	return 0
}
