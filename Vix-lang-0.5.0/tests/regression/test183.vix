fn add(a: i32, b: i32): i32
{
	return a + b
}

fn mul(a: i32, b: i32): i32
{
	return a * b
}

fn apply2(f: fn(i32, i32): i32, a: i32, b: i32): i32
{
	return f(a, b)
}

fn compose(f: fn(i32): i32, g: fn(i32): i32, x: i32): i32
{
	return f(g(x))
}

fn double_val(x: i32): i32 { return x * 2 }
fn add_one(x: i32): i32 { return x + 1 }

fn main(): i32
{
	print(apply2(add, 3, 4))
	print(apply2(mul, 3, 4))
	print(compose(double_val, add_one, 5))
	print(compose(add_one, double_val, 5))
	return 0
}
