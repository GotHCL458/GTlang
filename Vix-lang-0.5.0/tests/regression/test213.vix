// Nested elif with mixed string/int type promotion (regression: if codegen phi bug)
fn classify(x: i32)
{
	if (x > 100) {
		print("big")
	}
	elif (x > 10) {
		print("medium")
	}
	elif (x > 0) {
		print("small")
	}
	else {
		print("non-positive")
	}
}

fn main(): i32
{
	classify(200)
	classify(50)
	classify(5)
	classify(0)
	classify(-10)
	return 0
}
