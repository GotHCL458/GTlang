fn main(): i32 {
    let a = [[1, 2], [3, 4]]
    let b = [[5, 6], [7, 8]]
    let c00 = a[0][0] * b[0][0] + a[0][1] * b[1][0]
    let c01 = a[0][0] * b[0][1] + a[0][1] * b[1][1]
    let c10 = a[1][0] * b[0][0] + a[1][1] * b[1][0]
    let c11 = a[1][0] * b[0][1] + a[1][1] * b[1][1]
    print(c00)
    print(c01)
    print(c10)
    print(c11)
    return 0
}
