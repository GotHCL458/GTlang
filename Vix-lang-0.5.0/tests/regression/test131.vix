fn bubble_sort(arr: [i32], size: i32)
{
	for (i in 0 .. size - 1) {
		for (j in 0 .. size - i - 1) {
			if (arr[j] > arr[j + 1]) {
				let temp = arr[j]
				arr[j] = arr[j + 1]
				arr[j + 1] = temp
			}
		}
	}
}

fn main(): i32
{
	let arr = [64, 34, 25, 12, 22, 11, 90]
	bubble_sort(arr, 7)
	for (i in 0 .. arr.length) {
		print(arr[i])
	}
	return 0
}
