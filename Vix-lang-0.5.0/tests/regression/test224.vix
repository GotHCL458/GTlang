// Regression: string indexing with arithmetic (i8 + i32 type promotion)
fn hash_str(s: string): i32
{
	let mut hash = 5381
	let mut i = 0
	while (i < s.length)
	{
		hash = (hash * 33) + s[i]
		i = i + 1
	}
	if (hash < 0) { hash = -hash }
	return hash
}

fn main(): i32
{
	print(hash_str("hello"))
	print(hash_str("world"))
	print(hash_str(""))
	return 0
}
