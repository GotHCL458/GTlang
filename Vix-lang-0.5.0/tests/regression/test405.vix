type State = struct {
    tape: [i32],
    ptr: i32
}

fn inc_current(state: &State)
{
    state.tape[state.ptr] = state.tape[state.ptr] + 1
}

fn main(): i32
{
    let mut tape: [i32] = []
    tape.push(0)
    tape.push(0)

    let mut state = State{ tape: tape, ptr: 0 }
    state.tape[0] = 1
    state.tape[1] = 2
    print(state.tape[0])
    print(state.tape[1])

    inc_current(&state)
    state.ptr = 1
    inc_current(&state)
    print(state.tape[0])
    print(state.tape[1])
    print(state.ptr)
    return 0
}
