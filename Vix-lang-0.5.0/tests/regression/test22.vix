fn classify(x: i32): i32
{
    if (x > 100) {
        print("large")
    } elif (x > 10) {
        print("medium")
    } elif (x > 0) {
        print("small")
    } else {
        print("non-positive")
    }
    return 0
}

fn main(): i32
{
    classify(200)
    classify(50)
    classify(5)
    classify(-1)
    return 0
}
