fn is_prime(n: i32): i32 {
    if (n < 2) { return 0 }
    if (n == 2) { return 1 }
    if (n % 2 == 0) { return 0 }
    let mut i = 3
    while (i * i <= n) {
        if (n % i == 0) { return 0 }
        i = i + 2
    }
    return 1
}
fn nth_prime(n: i32): i32 {
    let mut count = 0
    let mut num = 2
    while (1) {
        if (is_prime(num) == 1) {
            count = count + 1
            if (count == n) { return num }
        }
        num = num + 1
    }
    return 0
}
fn main(): i32 {
    print(nth_prime(1))
    print(nth_prime(10))
    print(nth_prime(50))
    print(nth_prime(100))
    return 0
}
