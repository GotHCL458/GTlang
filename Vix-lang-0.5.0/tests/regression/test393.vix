fn contains(arr: [i32], val: i32): i32 {
    for (v in arr) { if (v == val) { return 1 } }
    return 0
}
fn unique(arr: [i32]): [i32] {
    let mut result: [i32] = []
    for (v in arr) {
        if (contains(result, v) == 0) { result.push(v) }
    }
    return result
}
fn main(): i32 {
    let arr = [1, 2, 3, 2, 4, 3, 5, 1]
    let u = unique(arr)
    for (v in u) { print(v) }
    print(u.length)
    return 0
}
