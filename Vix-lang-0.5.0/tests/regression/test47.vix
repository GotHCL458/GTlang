fn main(): i32
{
	let a = 1
	let b = 2
	let c = 3

	if (a == 1 and b == 2) { print("ab") }
	if (a == 1 and b == 3) { print("no") }
	if (a == 0 or b == 2) { print("bc") }
	if (a == 0 or b == 0) { print("no") }

	if (a < b and b < c) { print("ascending") }
	if (a > b or b < c) { print("mixed") }

	print(17 % 5)
	print(100 % 7)
	print(0 % 1)

	return 0
}
