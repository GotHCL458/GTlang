fn safe_div(a: i32, b: i32): ?i32 {
    if (b == 0) { return None }
    return Some(a / b)
}
fn main(): i32 {
    let r1 = safe_div(10, 3)
    let r2 = safe_div(10, 0)
    match r1 {
        Some(v) -> print(v)
        None -> print(0)
    }
    match r2 {
        Some(v) -> print(v)
        None -> print(-1)
    }
    return 0
}
