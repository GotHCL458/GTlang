fn gcd(a: i32, b: i32): i32 {
    let mut x = a
    let mut y = b
    while (y != 0) {
        let t = y
        y = x % y
        x = t
    }
    return x
}
fn totient(n: i32): i32 {
    let mut count = 0
    for (i in 1 .. n + 1) {
        if (gcd(i, n) == 1) { count = count + 1 }
    }
    return count
}
fn main(): i32 {
    print(totient(1))
    print(totient(9))
    print(totient(10))
    print(totient(12))
    return 0
}
