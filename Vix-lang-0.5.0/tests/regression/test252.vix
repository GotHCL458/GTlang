fn classify(n: i32): string {
    if (n > 0) {
        if (n > 100) { return "large" }
        elif (n > 10) { return "medium" }
        else { return "small" }
    }
    elif (n < 0) { return "negative" }
    else { return "zero" }
}
fn main(): i32 {
    print(classify(150))
    print(classify(50))
    print(classify(5))
    print(classify(0))
    print(classify(-10))
    return 0
}
