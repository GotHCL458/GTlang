struct Pair {
    first: i32,
    second: i32
}

fn add(a: i32, b: i32): i32
{
    return a + b
}

fn greet(name: string): string
{
    return name
}

fn make_pair(x: i32, y: i32): Pair
{
    return Pair{ first: x, second: y }
}

fn main(): i32
{
    let result = add(3, 4)
    print(result)

    let msg = greet("world")
    print(msg)

    let p = make_pair(100, 200)
    print(p.first)
    print(p.second)

    return 0
}
