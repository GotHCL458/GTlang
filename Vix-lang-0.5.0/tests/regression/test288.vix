fn insertion_sort(arr: &[i32]) {
    let n = arr.length
    for (i in 1 .. n) {
        let key = arr[i]
        let mut j = i - 1
        while (j >= 0 and arr[j] > key) {
            arr[j + 1] = arr[j]
            j = j - 1
        }
        arr[j + 1] = key
    }
}
fn main(): i32 {
    let mut arr = [12, 11, 13, 5, 6]
    insertion_sort(&arr)
    for (v in arr) { print(v) }
    return 0
}
