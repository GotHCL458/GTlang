fn main(): i32 {
    let n = 50
    let mut sieve: [i32] = []
    for (i in 0 .. n) {
        sieve.push(1)
    }
    sieve[0] = 0
    sieve[1] = 0
    let mut a = 2
    while (a * a < n) {
        if (sieve[a] == 1) {
            let mut j = a * a
            while (j < n) {
                sieve[j] = 0
                j = j + a
            }
        }
        a = a + 1
    }
    for (a in 0 .. n) {
        if (sieve[a] == 1) { print(a) }
    }
    return 0
}
