fn is_digit(c: i32): i32 { if (c >= 48 and c <= 57) { return 1 } return 0 }
fn is_alpha(c: i32): i32 {
    if (c >= 65 and c <= 90) { return 1 }
    if (c >= 97 and c <= 122) { return 1 }
    return 0
}
fn main(): i32 {
    print(is_digit(48))
    print(is_digit(65))
    print(is_alpha(65))
    print(is_alpha(48))
    return 0
}
