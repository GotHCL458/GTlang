struct Node {
    value: i32,
    next: &Node
}

fn print_list(n: &Node): void
{
    let cur = n
    print(cur.value)
    if (cur.next != nil)
    {
        print_list(cur.next)
    }
}

fn main(): i32
{
    let list = Node{ value: 10, next: &Node{ value: 20, next: &Node{ value: 30, next: nil } } }
    print_list(&list)
    return 0
}
