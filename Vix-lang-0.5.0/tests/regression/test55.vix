type Point = struct
{
	x: i32
	y: i32
}

fn manhattan(p: Point): i32
{
	let mut ax = p.x
	if (ax < 0) { ax = 0 - ax }
	let mut ay = p.y
	if (ay < 0) { ay = 0 - ay }
	return ax + ay
}

fn main(): i32
{
	let p1 = Point { x: 3, y: 4 }
	let p2 = Point { x: -5, y: 12 }
	let p3 = Point { x: 0, y: 0 }

	print(manhattan(p1))
	print(manhattan(p2))
	print(manhattan(p3))

	return 0
}
