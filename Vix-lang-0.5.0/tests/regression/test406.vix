struct Holder
{
    items: [string]
    count: i32
}

fn rebind(h: Holder): Holder
{
    let mut g = h
    g.items = ["new", "values"]
    g.count = 2
    return g
}

fn main(): i32
{
    let orig = Holder{ items: ["old"], count: 1 }
    let r = rebind(orig)
    print(r.items[0])
    print(r.items[1])
    print(r.count)
    return 0
}
