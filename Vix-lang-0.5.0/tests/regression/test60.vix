struct Pair
{
	first: i32
	second: i32
}

fn main(): i32
{
	let p = Pair { first: 10, second: 20 }
	print(p.first)
	print(p.second)

	let q = Pair { first: p.second, second: p.first }
	print(q.first)
	print(q.second)

	let r = Pair { first: p.first * 2, second: p.second * 2 }
	print(r.first)
	print(r.second)

	return 0
}
