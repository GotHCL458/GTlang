type Entry = struct { key: string, val: i32, used: i32 }

fn hash_key(key: string, size: i32): i32 {
    let mut h = 0
    for (i in 0 .. key.length) {
        h = (h * 31 + key[i]) % size
    }
    if (h < 0) { h = h + size }
    return h
}

fn main(): i32 {
    let mut entries: [Entry] = []
    for (i in 0 .. 16) {
        entries.push(Entry{ key: "", val: 0, used: 0 })
    }
    let idx1 = hash_key("alice", 16)
    entries[idx1] = Entry{ key: "alice", val: 30, used: 1 }
    let idx2 = hash_key("bob", 16)
    entries[idx2] = Entry{ key: "bob", val: 25, used: 1 }

    let e1 = entries[idx1]
    print(e1.val)
    let e2 = entries[idx2]
    print(e2.val)

    let idx3 = hash_key("charlie", 16)
    let e3 = entries[idx3]
    print(e3.used)
    return 0
}
