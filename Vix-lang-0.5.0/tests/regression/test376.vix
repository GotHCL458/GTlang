fn join(parts: [string], sep: string): string {
    if (parts.length == 0) { return "" }
    let mut result = parts[0]
    for (i in 1 .. parts.length) {
        result = result + sep + parts[i]
    }
    return result
}
fn main(): i32 {
    print(join(["hello", "world"], " "))
    print(join(["a", "b", "c"], ","))
    print(join(["one"], "-"))
    return 0
}
