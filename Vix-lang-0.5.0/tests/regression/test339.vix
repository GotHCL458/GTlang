fn main(): i32 {
    let n = 10
    let mut triangle: [[i32]] = []
    for (i in 0 .. n) {
        let mut r: [i32] = []
        for (j in 0 .. i + 1) {
            if (j == 0 or j == i) { r.push(1) }
            else {
                let prev = triangle[i - 1]
                r.push(prev[j - 1] + prev[j])
            }
        }
        triangle.push(r)
    }
    let row0 = triangle[0]
    let row1 = triangle[1]
    let row2 = triangle[2]
    let row3 = triangle[3]
    let row4 = triangle[4]
    let row5 = triangle[5]
    let row6 = triangle[6]
    let row7 = triangle[7]
    let row8 = triangle[8]
    let row9 = triangle[9]
    for (v in row0) { print(v) }
    for (v in row1) { print(v) }
    for (v in row2) { print(v) }
    for (v in row3) { print(v) }
    for (v in row4) { print(v) }
    for (v in row5) { print(v) }
    for (v in row6) { print(v) }
    for (v in row7) { print(v) }
    for (v in row8) { print(v) }
    for (v in row9) { print(v) }
    return 0
}
