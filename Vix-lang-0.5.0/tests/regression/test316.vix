fn find_person(name: string): ?i32 {
    if (name == "alice") { return Some(30) }
    return None
}
fn main(): i32 {
    let p = find_person("alice")
    match p {
        Some(age) -> print(age)
        None -> print(-1)
    }
    let q = find_person("bob")
    match q {
        Some(age) -> print(age)
        None -> print(-1)
    }
    return 0
}
