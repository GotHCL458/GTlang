type Result:[T, E] = Ok(T) | Err(E)

fn process(r: Result:[i32, string]): i32
{
    match r
    {
        Ok(v) -> return v
        Err(e) -> {
            return -1
        }
    }
    return 0
}

fn main(): i32
{
    let a = Ok(100) : Result:[i32, string]
    let b = Err("failed") : Result:[i32, string]

    let x = process(a)
    let y = process(b)

    print(x)
    print(y)

    return 0
}
