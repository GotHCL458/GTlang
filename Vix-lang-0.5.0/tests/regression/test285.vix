fn linear_search(arr: [i32], target: i32): i32 {
    for (i in 0 .. arr.length) {
        if (arr[i] == target) { return i }
    }
    return -1
}
fn main(): i32 {
    let arr = [4, 7, 2, 9, 1, 5]
    print(linear_search(arr, 9))
    print(linear_search(arr, 1))
    print(linear_search(arr, 8))
    return 0
}
