fn collatz_len(n: i32): i32 {
    let mut len = 1
    let mut x = n
    while (x != 1) {
        if (x % 2 == 0) { x = x / 2 }
        else { x = 3 * x + 1 }
        len = len + 1
    }
    return len
}
fn main(): i32 {
    print(collatz_len(1))
    print(collatz_len(6))
    print(collatz_len(27))
    return 0
}
