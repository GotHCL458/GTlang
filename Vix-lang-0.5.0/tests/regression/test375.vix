fn sort(arr: [i32]) {
    let n = arr.length
    for (i in 0 .. n) {
        for (j in 0 .. n - i - 1) {
            if (arr[j] > arr[j + 1]) {
                let tmp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = tmp
            }
        }
    }
}
fn search(arr: [i32], target: i32): i32 {
    let mut lo = 0
    let mut hi = arr.length - 1
    while (lo <= hi) {
        let mid = lo + (hi - lo) / 2
        if (arr[mid] == target) { return mid }
        elif (arr[mid] < target) { lo = mid + 1 }
        else { hi = mid - 1 }
    }
    return -1
}
fn main(): i32 {
    let mut arr = [5, 3, 8, 1, 9, 2, 7, 4, 6]
    sort(arr)
    print(search(arr, 1))
    print(search(arr, 5))
    print(search(arr, 9))
    print(search(arr, 10))
    return 0
}
