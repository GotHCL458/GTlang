fn main(): i32
{
	let a = Some(42)
	let b: ?i32 = None

	match a {
		Some(_) -> print("has-value")
		None -> print("none")
	}
	match b {
		Some(_) -> print("has-value")
		None -> print("none")
	}

	let c = Some("hello")
	match c {
		Some(_) -> print("has-string")
		None -> print("none")
	}
	return 0
}
