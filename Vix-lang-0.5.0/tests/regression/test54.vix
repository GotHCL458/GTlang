fn sum_range(start: i32, end: i32): i32
{
	let mut s = 0
	let mut i = start
	while (i <= end)
	{
		s += i
		i += 1
	}
	return s
}

fn factorial(n: i32): i32
{
	if (n <= 1) { return 1 }
	return n * factorial(n - 1)
}

fn is_even(n: i32): i32
{
	if (n % 2 == 0) { return 1 }
	return 0
}

fn main(): i32
{
	print(sum_range(1, 10))
	print(sum_range(1, 100))
	print(factorial(5))
	print(factorial(10))
	print(is_even(4))
	print(is_even(7))

	return 0
}
