fn collatz_steps(n: i32): i32
{
	let mut steps = 0
	let mut val = n
	while (val != 1) {
		if (val % 2 == 0) {
			val = val / 2
		}
		else {
			val = val * 3 + 1
		}
		steps = steps + 1
	}
	return steps
}

fn main(): i32
{
	print(collatz_steps(1))
	print(collatz_steps(2))
	print(collatz_steps(6))
	print(collatz_steps(27))
	return 0
}
