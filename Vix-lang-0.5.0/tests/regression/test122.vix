fn is_prime(n: i32): i32
{
	if (n <= 1) {
		return 0
	}
	if (n <= 3) {
		return 1
	}
	if (n % 2 == 0) {
		return 0
	}
	let mut i = 3
	while (i * i <= n) {
		if (n % i == 0) {
			return 0
		}
		i = i + 2
	}
	return 1
}

fn main(): i32
{
	print(is_prime(0))
	print(is_prime(1))
	print(is_prime(2))
	print(is_prime(3))
	print(is_prime(4))
	print(is_prime(5))
	print(is_prime(17))
	print(is_prime(100))
	return 0
}
