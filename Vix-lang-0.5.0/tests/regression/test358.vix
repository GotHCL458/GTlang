fn mod_pow(base: i32, exp: i32, mod_val: i32): i32 {
    let mut result = 1
    let mut b = base % mod_val
    let mut e = exp
    while (e > 0) {
        if (e % 2 == 1) { result = (result * b) % mod_val }
        e = e / 2
        b = (b * b) % mod_val
    }
    return result
}
fn main(): i32 {
    print(mod_pow(2, 10, 1000))
    print(mod_pow(3, 13, 1000000))
    print(mod_pow(7, 256, 13))
    return 0
}
