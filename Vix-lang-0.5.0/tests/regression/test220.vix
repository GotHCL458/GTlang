// Deeply nested elif chain with 4+ branches
fn grade(score: i32)
{
	if (score >= 90) {
		print("A")
	}
	elif (score >= 80) {
		print("B")
	}
	elif (score >= 70) {
		print("C")
	}
	elif (score >= 60) {
		print("D")
	}
	else {
		print("F")
	}
}

fn main(): i32
{
	grade(95)
	grade(85)
	grade(75)
	grade(65)
	grade(50)
	return 0
}
