fn hanoi(n: i32, from: string, to: string, aux: string) {
    if (n == 1) {
        print("move " + from + " -> " + to)
        return
    }
    hanoi(n - 1, from, aux, to)
    print("move " + from + " -> " + to)
    hanoi(n - 1, aux, to, from)
}
fn main(): i32 {
    hanoi(3, "A", "C", "B")
    return 0
}
