fn ackermann(m: i32, n: i32): i32
{
	if (m == 0)
	{
		return n + 1
	}
	if (n == 0)
	{
		return ackermann(m - 1, 1)
	}
	return ackermann(m - 1, ackermann(m, n - 1))
}

fn main(): i32
{
	print(ackermann(0, 0))
	print(ackermann(0, 5))
	print(ackermann(1, 0))
	print(ackermann(1, 1))
	print(ackermann(2, 1))
	print(ackermann(3, 2))
	return 0
}
