fn opposite(d: i32): i32 {
    match d {
        1 -> return 2
        2 -> return 1
        3 -> return 4
        4 -> return 3
        _ -> return 0
    }
}
fn to_string(d: i32): string {
    match d {
        1 -> return "North"
        2 -> return "South"
        3 -> return "East"
        4 -> return "West"
        _ -> return "Unknown"
    }
}
fn main(): i32 {
    print(to_string(opposite(1)))
    print(to_string(opposite(3)))
    return 0
}