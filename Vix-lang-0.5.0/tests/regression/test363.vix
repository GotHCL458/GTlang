fn main(): i32 {
    let matrix = [[1, 2], [3, 4], [5, 6]]
    let mut flat: [i32] = []
    let row0 = matrix[0]
    let row1 = matrix[1]
    let row2 = matrix[2]
    for (v in row0) { flat.push(v) }
    for (v in row1) { flat.push(v) }
    for (v in row2) { flat.push(v) }
    for (v in flat) { print(v) }
    return 0
}
