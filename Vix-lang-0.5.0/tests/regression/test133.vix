fn count_occurrences(arr: [i32], size: i32, target: i32): i32
{
	let mut count = 0
	for (i in 0 .. size) {
		if (arr[i] == target) {
			count = count + 1
		}
	}
	return count
}

fn main(): i32
{
	let arr = [1, 2, 3, 2, 4, 2, 5]
	print(count_occurrences(arr, 7, 2))
	print(count_occurrences(arr, 7, 1))
	print(count_occurrences(arr, 7, 99))
	return 0
}
