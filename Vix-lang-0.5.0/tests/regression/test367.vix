fn double(x: i32): i32 { return x * 2 }
fn main(): i32 {
    let r1 = Ok(21) : Result:[i32, string]
    let r2 = Err("fail") : Result:[i32, string]
    match r1 {
        Ok(v) -> print(double(v))
        Err(e) -> print(-1)
    }
    match r2 {
        Ok(v) -> print(double(v))
        Err(e) -> print(-1)
    }
    return 0
}