fn reduce(arr: [i32], init: i32, f: fn(i32, i32): i32): i32 {
    let mut acc = init
    for (v in arr) {
        acc = f(acc, v)
    }
    return acc
}
fn add(a: i32, b: i32): i32 { return a + b }
fn mul(a: i32, b: i32): i32 { return a * b }
fn main(): i32 {
    let arr = [1, 2, 3, 4, 5]
    print(reduce(arr, 0, add))
    print(reduce(arr, 1, mul))
    return 0
}
