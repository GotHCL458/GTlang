fn zip(a: [i32], b: [string]): [(i32, string)] {
    let mut result: [(i32, string)] = []
    let mut len = a.length
    if (b.length < len) { len = b.length }
    for (i in 0 .. len) {
        result.push((a[i], b[i]))
    }
    return result
}
fn main(): i32 {
    let nums = [1, 2, 3]
    let words = ["one", "two", "three"]
    let pairs = zip(nums, words)
    for (p in pairs) {
        print(p.0)
        print(p.1)
    }
    return 0
}
