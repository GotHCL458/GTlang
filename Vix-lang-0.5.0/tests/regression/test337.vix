fn contains_str(haystack: string, needle: string): i32 {
    if (needle.length > haystack.length) { return 0 }
    let mut i = 0
    while (i <= haystack.length - needle.length) {
        let mut found = 1
        for (j in 0 .. needle.length) {
            if (haystack[i + j] != needle[j]) { found = 0 }
        }
        if (found == 1) { return 1 }
        i = i + 1
    }
    return 0
}
fn main(): i32 {
    print(contains_str("hello world", "world"))
    print(contains_str("hello world", "xyz"))
    print(contains_str("abcdef", "cde"))
    return 0
}
