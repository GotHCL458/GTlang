type Result:[T, E] = Ok(T) | Err(E)

fn main(): i32
{
    let r1 = Ok(5) : Result:[i32, string]
    let r2 = Err("cannot divide by zero") : Result:[i32, string]

    match r1
    {
        Ok(v) -> print(v)
        Err(e) -> print(e)
    }

    match r2
    {
        Ok(v) -> print(v)
        Err(e) -> print(e)
    }

    return 0
}
