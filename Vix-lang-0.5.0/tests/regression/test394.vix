fn partition(arr: [i32], pivot: i32, lo: [i32], hi: [i32]): i32 {
    for (v in arr) {
        if (v < pivot) { lo.push(v) }
        else { hi.push(v) }
    }
    return 0
}
fn main(): i32 {
    let arr = [5, 3, 8, 1, 9, 2, 7, 4, 6]
    let mut lo: [i32] = []
    let mut hi: [i32] = []
    for (v in arr) {
        if (v < 5) { lo.push(v) }
        else { hi.push(v) }
    }
    for (v in lo) { print(v) }
    print(-1)
    for (v in hi) { print(v) }
    return 0
}