fn is_palindrome(s: string): i32 {
    let n = s.length
    let mut i = 0
    while (i < n / 2) {
        if (s[i] != s[n - 1 - i]) { return 0 }
        i = i + 1
    }
    return 1
}
fn main(): i32 {
    print(is_palindrome("racecar"))
    print(is_palindrome("hello"))
    print(is_palindrome("abba"))
    return 0
}
