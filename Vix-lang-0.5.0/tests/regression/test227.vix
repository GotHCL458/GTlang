type Counter = struct {
    value: i32
    name: string
}

fn increment(c: &Counter)
{
    c.value = c.value + 1
}

fn set_name(c: &Counter, n: string)
{
    c.name = n
}

fn main(): i32
{
    let mut ctr = Counter{ value: 0, name: "init" }
    increment(&ctr)
    increment(&ctr)
    increment(&ctr)
    set_name(&ctr, "updated")
    print(ctr.value)
    print(ctr.name)
    return 0
}
