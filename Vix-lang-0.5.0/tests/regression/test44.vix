type Result:[T, E] = Ok(T) | Err(E)

fn unwrap_or(r: Result:[i32, string], default: i32): i32
{
    match r
    {
        Ok(v) -> return v
        Err(_) -> return default
    }
    return default
}

fn main(): i32
{
    let a = Ok(42) : Result:[i32, string]
    let b = Err("fail") : Result:[i32, string]

    let x = unwrap_or(a, 0)
    let y = unwrap_or(b, -1)

    print(x)
    print(y)

    let names = ["alice", "bob", "charlie"]
    let mut first = "none"
    if (names.length > 0)
    {
        first = names[0]
    }
    print(first)

    return 0
}
