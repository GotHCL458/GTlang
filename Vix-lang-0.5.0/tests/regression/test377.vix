fn main(): i32 {
    let s = "hello world test"
    let delim: i32 = 32
    let mut count = 1
    let mut last_was_delim = 0
    for (i in 0 .. s.length) {
        if (s[i] == delim) {
            if (last_was_delim == 0) { count = count + 1 }
            last_was_delim = 1
        } else {
            last_was_delim = 0
        }
    }
    print(count)
    return 0
}
