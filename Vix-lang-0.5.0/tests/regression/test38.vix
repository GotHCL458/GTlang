fn main(): i32
{
    let ints = [1, 2, 3, 4, 5]
    let strs = ["hello", "world"]
    let floats = [1.5, 2.5, 3.5]

    print(ints.length)
    print(strs.length)
    print(floats.length)

    print(ints[0])
    print(ints[4])
    print(strs[0])
    print(strs[1])
    print(floats[0])

    return 0
}
