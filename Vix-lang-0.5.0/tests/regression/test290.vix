fn find_min(arr: [i32]): i32 {
    let mut min = arr[0]
    for (i in 1 .. arr.length) {
        if (arr[i] < min) { min = arr[i] }
    }
    return min
}
fn find_max(arr: [i32]): i32 {
    let mut max = arr[0]
    for (i in 1 .. arr.length) {
        if (arr[i] > max) { max = arr[i] }
    }
    return max
}
fn main(): i32 {
    let arr = [3, 7, 1, 9, 4, 6, 2, 8, 5]
    print(find_min(arr))
    print(find_max(arr))
    return 0
}
