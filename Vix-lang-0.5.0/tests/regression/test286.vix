fn bubble_sort(arr: &[i32]) {
    let n = arr.length
    for (i in 0 .. n) {
        for (j in 0 .. n - i - 1) {
            if (arr[j] > arr[j + 1]) {
                let tmp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = tmp
            }
        }
    }
}
fn main(): i32 {
    let mut arr = [64, 34, 25, 12, 22, 11, 90]
    bubble_sort(&arr)
    for (v in arr) { print(v) }
    return 0
}
