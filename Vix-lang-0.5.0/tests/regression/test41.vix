struct Pair {
    first: i32,
    second: i32
}

struct Container {
    name: string,
    data: [i32],
    point: Pair
}

fn main(): i32
{
    let p = Pair{ first: 10, second: 20 }
    let c = Container{ name: "test", data: [1, 2, 3], point: p }

    print(p.first)
    print(p.second)
    print(c.name)
    print(c.data.length)
    print(c.data[0])
    print(c.point.first)

    return 0
}
