fn apply(op: i32, a: i32, b: i32): i32 {
    match op {
        1 -> return a + b
        2 -> return a - b
        3 -> return a * b
        4 -> return a / b
        _ -> return 0
    }
}
fn main(): i32 {
    print(apply(1, 10, 5))
    print(apply(2, 10, 5))
    print(apply(3, 10, 5))
    print(apply(4, 10, 5))
    return 0
}