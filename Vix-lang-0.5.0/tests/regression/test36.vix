type Result:[T, E] = Ok(T) | Err(E)

fn main(): i32
{
    let x = Ok(42) : Result:[i32, string]
    let y = Err("error") : Result:[i32, string]
    let z = Ok(0) : Result:[i32, string]

    match x
    {
        Ok(v) -> {
            if (v == 42)
            {
                print("correct")
            }
        }
        Err(e) -> print(e)
    }

    match y
    {
        Ok(v) -> print(v)
        Err(e) -> {
            if (e == "error")
            {
                print("error matched")
            }
        }
    }

    match z
    {
        Ok(v) -> print(v)
        Err(e) -> print(e)
    }

    return 0
}
