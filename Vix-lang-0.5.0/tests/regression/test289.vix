fn reverse(arr: &[i32]) {
    let n = arr.length
    let mut i = 0
    while (i < n / 2) {
        let tmp = arr[i]
        arr[i] = arr[n - 1 - i]
        arr[n - 1 - i] = tmp
        i = i + 1
    }
}
fn main(): i32 {
    let mut arr = [1, 2, 3, 4, 5]
    reverse(&arr)
    for (v in arr) { print(v) }
    return 0
}
