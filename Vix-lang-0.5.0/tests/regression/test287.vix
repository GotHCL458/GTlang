fn selection_sort(arr: &[i32]) {
    let n = arr.length
    for (i in 0 .. n) {
        let mut min_idx = i
        for (j in i + 1 .. n) {
            if (arr[j] < arr[min_idx]) { min_idx = j }
        }
        let tmp = arr[i]
        arr[i] = arr[min_idx]
        arr[min_idx] = tmp
    }
}
fn main(): i32 {
    let mut arr = [29, 10, 14, 37, 13]
    selection_sort(&arr)
    for (v in arr) { print(v) }
    return 0
}
