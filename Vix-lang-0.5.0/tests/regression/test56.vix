type Result:[T, E] = Ok(T) | Err(E)

fn main(): i32
{
	let mut results = [0, 0, 0]
	let cases = [10, 0, 5]
	let divisors = [2, 0, 5]

	let mut i = 0
	while (i < 3)
	{
		if (divisors[i] == 0)
		{
			results[i] = -1
		}
		else
		{
			results[i] = cases[i] / divisors[i]
		}
		i += 1
	}

	for (v in results)
	{
		print(v)
	}

	let nested = [[1, 2], [3, 4], [5, 6]]
	print(nested[0][0])
	print(nested[1][1])
	print(nested[2][0])

	return 0
}
