fn linear_search(arr: [i32], size: i32, target: i32): i32
{
	for (i in 0 .. size) {
		if (arr[i] == target) {
			return i
		}
	}
	return -1
}

fn main(): i32
{
	let arr = [10, 20, 30, 40, 50]
	print(linear_search(arr, 5, 30))
	print(linear_search(arr, 5, 10))
	print(linear_search(arr, 5, 99))
	return 0
}
