fn main(): i32
{
    let x = 10
    let y = 20
    let z = x + y
    let w = z * 2
    let q = w - 5

    print(z)
    print(w)
    print(q)

    let a = 3.14
    let b = 2.0
    let c = a + b
    print(c)

    let s1 = "hello"
    let s2 = "world"
    print(s1)
    print(s2)

    let flag = 1
    let mut n = 0
    if (flag == 1)
    {
        n = 1
    }
    print(n)

    return 0
}
