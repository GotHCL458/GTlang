fn starts_with(s: string, prefix: string): i32 {
    if (prefix.length > s.length) { return 0 }
    for (i in 0 .. prefix.length) {
        if (s[i] != prefix[i]) { return 0 }
    }
    return 1
}
fn main(): i32 {
    print(starts_with("hello world", "hello"))
    print(starts_with("hello world", "world"))
    print(starts_with("test", "test"))
    return 0
}
