fn main(): i32 {
    let a = [[1, 2], [3, 4]]
    let b = [[5, 6], [7, 8]]
    let mut result: [[i32]] = []
    for (i in 0 .. 2) {
        let mut row: [i32] = []
        for (j in 0 .. 2) {
            row.push(a[i][j] + b[i][j])
        }
        result.push(row)
    }
    print(result[0][0])
    print(result[0][1])
    print(result[1][0])
    print(result[1][1])
    return 0
}
