fn reverse_array(mut arr: [i32], size: i32)
{
	let mut left = 0
	let mut right = size - 1
	while (left < right) {
		let temp = arr[left]
		arr[left] = arr[right]
		arr[right] = temp
		left = left + 1
		right = right - 1
	}
}

fn main(): i32
{
	let arr = [1, 2, 3, 4, 5]
	reverse_array(arr, 5)
	for (i in 0 .. 5) {
		print(arr[i])
	}
	return 0
}
