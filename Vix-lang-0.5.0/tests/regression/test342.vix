fn counting_sort(arr: [i32], max_val: i32) {
    let mut count: [i32] = []
    for (i in 0 .. max_val + 1) { count.push(0) }
    for (i in 0 .. arr.length) { count[arr[i]] = count[arr[i]] + 1 }
    let mut idx = 0
    for (i in 0 .. max_val + 1) {
        let mut j = 0
        while (j < count[i]) {
            arr[idx] = i
            idx = idx + 1
            j = j + 1
        }
    }
}
fn main(): i32 {
    let mut arr = [4, 2, 2, 8, 3, 3, 1]
    counting_sort(arr, 8)
    for (v in arr) { print(v) }
    return 0
}
