fn eval_expr(tokens: [i32]): i32 {
    let mut result = 0
    let mut op = 0
    let mut i = 0
    while (i < tokens.length) {
        let t = tokens[i]
        if (t >= 0) {
            if (op == 0) { result = t }
            elif (op == 1) { result = result + t }
            elif (op == 2) { result = result - t }
            elif (op == 3) { result = result * t }
            elif (op == 4) { result = result / t }
        }
        else {
            op = -t
        }
        i = i + 1
    }
    return result
}
fn main(): i32 {
    let tokens1 = [10, -1, 20, 0]
    print(eval_expr(tokens1))
    let tokens2 = [10, -3, 5, -2, 3, 0]
    print(eval_expr(tokens2))
    let tokens3 = [100, -4, 4, -1, 10, 0]
    print(eval_expr(tokens3))
    return 0
}