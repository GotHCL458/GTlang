fn is_space(c: i32): i32 {
    if (c == 32) { return 1 }
    if (c == 9) { return 1 }
    if (c == 10) { return 1 }
    return 0
}

fn trim_len(s: string): i32 {
    let n = s.length
    let mut start = 0
    let mut end = n - 1
    while (start < n and is_space(s[start]) == 1) { start = start + 1 }
    while (end >= start and is_space(s[end]) == 1) { end = end - 1 }
    return end - start + 1
}

fn main(): i32 {
    print(trim_len("  hello  "))
    print(trim_len("test"))
    print(trim_len("  spaces  "))
    return 0
}
