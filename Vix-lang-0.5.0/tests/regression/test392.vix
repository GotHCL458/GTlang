fn apply_n(f: fn(i32): i32, x: i32, n: i32): i32 {
    let mut result = x
    for (i in 0 .. n) {
        result = f(result)
    }
    return result
}
fn main(): i32 {
    let double = fn(x: i32): i32 { return x * 2 }
    let add_one = fn(x: i32): i32 { return x + 1 }
    print(apply_n(double, 1, 5))
    print(apply_n(add_one, 0, 10))
    return 0
}
