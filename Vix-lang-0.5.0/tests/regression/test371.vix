fn perimeter(kind: i32, a: i32, b: i32): i32 {
    match kind {
        1 -> return 6 * a
        2 -> return 2 * (a + b)
        3 -> return a + b + b
        _ -> return 0
    }
}
fn main(): i32 {
    print(perimeter(1, 5, 0))
    print(perimeter(2, 3, 4))
    print(perimeter(3, 3, 4))
    return 0
}