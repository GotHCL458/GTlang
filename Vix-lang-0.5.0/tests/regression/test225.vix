type Pair = struct {
    first: i32
    second: i32
}

type Container = struct {
    val: i32
    name: string
}

fn read_pair(p: &Container): i32
{
    return p.val
}

fn read_name(p: &Container): string
{
    return p.name
}

fn main(): i32
{
    let c = Container{ val: 42, name: "hello" }
    let v = read_pair(&c)
    let n = read_name(&c)
    print(v)
    print(n)
    return 0
}
