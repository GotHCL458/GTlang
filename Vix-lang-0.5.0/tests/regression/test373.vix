fn unwrap_or(r: Result:[i32, string], default: i32): i32 {
    match r {
        Ok(v) -> return v
        Err(_) -> return default
    }
}
fn main(): i32 {
    let r1 = Ok(42) : Result:[i32, string]
    let r2 = Err("fail") : Result:[i32, string]
    print(unwrap_or(r1, 0))
    print(unwrap_or(r2, 0))
    return 0
}