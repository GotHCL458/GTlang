fn A(mut k: i32, x1: fn(): i32, x2: fn(): i32, x3: fn(): i32, x4: fn(): i32, x5: fn(): i32): i32
{
    fn B(): i32 {
        k = k - 1
        return A(k,
            fn(): i32 { B() },
            x1,
            x2,
            x3,
            x4)
    }

    if (k <= 0) {
        return x4() + x5()
    }

    return B()
}

fn main(): i32
{
    print(A(10,
        fn(): i32 { 1 },
        fn(): i32 { -1 },
        fn(): i32 { -1 },
        fn(): i32 { 1 },
        fn(): i32 { 0 }
    ))
    return 0
}
