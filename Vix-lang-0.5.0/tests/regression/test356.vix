fn prime_factors(n: i32): [i32] {
    let mut factors: [i32] = []
    let mut x = n
    let mut d = 2
    while (d * d <= x) {
        while (x % d == 0) {
            factors.push(d)
            x = x / d
        }
        d = d + 1
    }
    if (x > 1) { factors.push(x) }
    return factors
}
fn main(): i32 {
    let f = prime_factors(60)
    for (v in f) { print(v) }
    let f2 = prime_factors(97)
    for (v in f2) { print(v) }
    return 0
}
