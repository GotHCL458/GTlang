type HashMap:[V] = struct
{
	buckets: [ [ (string, V) ] ]
	size: i32
}
fn normalize_capacity(capacity: i32): i32
{
	if (capacity <= 0) { return 1 }
	return capacity
}
fn hash_str(s: string): i32
{
	let mut hash = 5381
	for (i in 0 .. s.length)
	{
		hash = (hash * 33) + s[i]
	}
	if (0 > hash)
	{ 
		hash = -hash
	}
	return hash
}

fn bucket_index(key: string, capacity: i32): i32
{
	let mut h = hash_str(key)
	if (0 > h) { h = -h }
	return h % capacity
}

pub fn new_hashmap:[V](capacity: i32): HashMap:[V]
{
	let cap = normalize_capacity(capacity)
	let buckets: [ [ (string, V) ] ] = []
	for (i in 0 .. cap)
	{
		buckets.push([])
	}
	return HashMap:[V]{ buckets: buckets, size: 0 }
}

pub fn len:[V](map: HashMap:[V]): i32
{
	return map.size
}

pub fn capacity:[V](map: HashMap:[V]): i32
{
	return map.buckets.length
}

pub fn put:[V](map: &HashMap:[V], key: string, value: V)
{
    let cap = map.buckets.length
    if (cap == 0) { return }
    let idx = bucket_index(key, cap)

    for (i in 0 .. map.buckets[idx].length)
    {
        let entry = map.buckets[idx][i]
        if (entry.0 == key)
        {
            map.buckets[idx][i] = (key, value)
            return
        }
    }

    map.buckets[idx].push((key, value))
    map.size = map.size + 1
}

pub fn get:[V](map: HashMap:[V], key: string): ?V
{
	let cap = map.buckets.length
	if (cap == 0) { return None }
	let idx = bucket_index(key, cap)

	for (i in 0 .. map.buckets[idx].length)
	{
		let entry = map.buckets[idx][i]
		if (entry.0 == key)
		{
			return Some(entry.1)
		}
	}
	return None
}

pub fn contains:[V](map: HashMap:[V], key: string): bool
{
	let found = get:[V](map, key)
	match found
	{
		Some(_) -> return true
		None -> return false
	}
}
fn main(): i32
{
    let mut map = new_hashmap:[i32](10)
    put:[i32](&map, "one", 1)
    put:[i32](&map, "two", 2)
    put:[i32](&map, "three", 3)

    let c1 = contains:[i32](map, "one")
    let c2 = contains:[i32](map, "two")
    let c3 = contains:[i32](map, "three")
    let c4 = contains:[i32](map, "four")

    print(c1)
    print(c2)
    print(c3)
    print(c4)

    return 0
}
