import "net.vix"

pub type Result:[T, E] = Ok(T) | Err(E)

pub type TcpStream = struct
{
    fd: i32
}
pub type Socket = struct
{
    fd: i32
}
pub type TcpListener = struct
{
    fd: i32
}

extern "C"
{
    fn close(fd: i32): i32
    fn setsockopt(sockfd: i32, level: i32, optname: i32, optval: ptr, optlen: usize): i32
    fn accept(sockfd: i32, addr: ptr, addrlen: ptr): i32
}

pub fn connect(ip: string, port: i32): Result:[TcpStream, string]
{
    let r = new_tcp()
    match r
    {
        Ok(sock) ->
        {
            let addr = make_addr(ip, port)
            let res = connect_tcp(sock, addr)
            match res
            {
                Ok(_) -> return Ok(TcpStream{ fd: sock.fd })
                Err(e) ->
                {
                    sock_close(sock)
                    return Err(e)
                }
            }
        }
        Err(e) -> return Err(e)
    }
}

pub fn send_data(stream: TcpStream, data: ptr, len: i32): Result:[i32, string]
{
    let sock = Socket{ fd: stream.fd }
    let sent = sock_send(sock, data, len)
    if (sent < 0)
    {
        return Err("Failed to send data")
    }
    return Ok(sent)
}

pub fn recv_data(stream: TcpStream, buf: ptr, len: i32): Result:[i32, string]
{
    let sock = Socket{ fd: stream.fd }
    let received = sock_recv(sock, buf, len)
    if (received < 0)
    {
        return Err("Failed to receive data")
    }
    
    return Ok(received)
}

pub fn close_stream(stream: TcpStream)
{
    close(stream.fd)
}

pub fn bind(ip: string, port: i32): Result:[TcpListener, string]
{
    let fd = socket(2, 1, 0)
    if (fd < 0)
    {
        return Err("Failed to create socket")
    }
    let optval: i32 = 1
    setsockopt(fd, 1, 2, &optval, 4)
    let addr = make_addr(ip, port)
    let sock = Socket{ fd: fd }
    let res = sock_bind(sock, addr)
    if (res < 0)
    {
        close(fd)
        return Err("Failed to bind")
    }
    return Ok(TcpListener{ fd: fd })
}

pub fn start_listen(listener: TcpListener, backlog: i32): Result:[i32, string]
{
    let sock = Socket{ fd: listener.fd }
    let res = sock_listen(sock, backlog)
    if (res < 0)
    {
        return Err("Failed to listen")
    }
    return Ok(0)
}

pub fn accept_conn(listener: TcpListener): Result:[TcpStream, string]
{
    let client_fd = accept(listener.fd, 0, 0)
    if (client_fd < 0)
    {
        return Err("Failed to accept connection")
    }
    return Ok(TcpStream{ fd: client_fd })
}

pub fn close_listener(listener: TcpListener)
{
    close(listener.fd)
}

pub fn send_all(stream: TcpStream, data: ptr, len: i32): Result:[i32, string]
{
    let mut sent = 0
    while (sent < len)
    {
        let sock = Socket{ fd: stream.fd }
        let n = sock_send(sock, data + sent, len - sent)
        if (n < 0)
        {
            return Err("Failed to send data")
        }
        sent = sent + n
    }
    return Ok(sent)
}

pub fn recv_all(stream: TcpStream, buf: ptr, len: i32): Result:[i32, string]
{
    let mut received = 0
    while (received < len)
    {
        let sock = Socket{ fd: stream.fd }
        let n = sock_recv(sock, buf + received, len - received)
        if (n <= 0)
        {
            return Err("Connection closed or error")
        }
        received = received + n
    }
    return Ok(received)
}

pub fn send_string(stream: TcpStream, msg: string): Result:[i32, string]
{
    let mut len = 0
    while (msg[len] != 0)
    {
        len = len + 1
    }
    return send_all(stream, msg, len)
}
