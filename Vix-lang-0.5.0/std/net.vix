extern "C"
{
    fn socket(domain: i32, type_: i32, protocol: i32): i32
    fn connect(sockfd: i32, addr: ptr, addrlen: usize): i32
    fn send(sockfd: i32, buf: ptr, len: usize, flags: i32): i32
    fn recv(sockfd: i32, buf: ptr, len: usize, flags: i32): i32
    fn bind(sockfd: i32, addr: ptr, addrlen: usize): i32
    fn listen(sockfd: i32, backlog: i32): i32
    fn accept(sockfd: i32, addr: ptr, addrlen: ptr): i32
    fn close(fd: i32): i32
    fn shutdown(sockfd: i32, how: i32): i32
    fn setsockopt(sockfd: i32, level: i32, optname: i32, optval: ptr, optlen: usize): i32
    fn getsockopt(sockfd: i32, level: i32, optname: i32, optval: ptr, optlen: ptr): i32
    fn htons(hostshort: u16): u16
    fn htonl(hostlong: u32): u32
    fn ntohs(netshort: u16): u16
    fn ntohl(netlong: u32): u32
    fn inet_addr(cp: ptr): u32
    fn inet_ntoa(addr: u32): ptr
    fn sendto(sockfd: i32, buf: ptr, len: usize, flags: i32, dest_addr: ptr, addrlen: usize): isize
    fn recvfrom(sockfd: i32, buf: ptr, len: usize, flags: i32, src_addr: ptr, addrlen: ptr): isize
    fn gethostname(name: ptr, len: usize): i32
    fn getpeername(sockfd: i32, addr: ptr, addrlen: ptr): i32
    fn getsockname(sockfd: i32, addr: ptr, addrlen: ptr): i32
    fn fcntl(fd: i32, cmd: i32, ...): i32
    fn malloc(size: usize): ptr
    fn free(ptr: ptr): void
}

pub type Result:[T, E] = Ok(T) | Err(E)

pub type sockaddr_in = struct
{
    sin_family: i32,
    sin_port: i32,
    sin_addr: i32,
    sin_zero: [i32 * 8]
}

pub type Socket = struct
{
    fd: i32
}

pub fn new_tcp(): Result:[Socket, string]
{
    let fd = socket(2, 1, 0)
    if (fd < 0)
    {
        return Err("Failed to create TCP socket")
    }
    return Ok(Socket{ fd: fd })
}

pub fn new_udp(): Result:[Socket, string]
{
    let fd = socket(2, 2, 0)
    if (fd < 0)
    {
        return Err("Failed to create UDP socket")
    }
    return Ok(Socket{ fd: fd })
}

pub fn connect_tcp(sock: Socket, address: sockaddr_in): Result:[i32, string]
{
    let res = connect(sock.fd, &address, 16)
    if (res < 0)
    {
        return Err("Failed to connect")
    }
    return Ok(0)
}

pub fn sock_bind(sock: Socket, address: sockaddr_in): Result:[i32, string]
{
    let res = bind(sock.fd, &address, 16)
    if (res < 0)
    {
        return Err("Failed to bind")
    }
    return Ok(0)
}

pub fn sock_listen(sock: Socket, backlog: i32): Result:[i32, string]
{
    let res = listen(sock.fd, backlog)
    if (res < 0)
    {
        return Err("Failed to listen")
    }
    return Ok(0)
}

pub fn sock_accept(sock: Socket): Result:[Socket, string]
{
    let client_fd = accept(sock.fd, 0, 0)
    if (client_fd < 0)
    {
        return Err("Failed to accept")
    }
    return Ok(Socket{ fd: client_fd })
}

pub fn sock_send(sock: Socket, buf: ptr, len: usize): i32
{
    return send(sock.fd, buf, len, 0)
}

pub fn sock_recv(sock: Socket, buf: ptr, len: usize): i32
{
    return recv(sock.fd, buf, len, 0)
}

pub fn sock_close(sock: Socket): i32
{
    return close(sock.fd)
}

pub fn sock_shutdown(sock: Socket, how: i32): i32
{
    return shutdown(sock.fd, how)
}

pub fn set_reuse_addr(sock: Socket): i32
{
    let optval: i32 = 1
    return setsockopt(sock.fd, 1, 2, &optval, 4)
}

pub fn set_reuse_port(sock: Socket): i32
{
    let optval: i32 = 1
    return setsockopt(sock.fd, 1, 15, &optval, 4)
}

pub fn set_keepalive(sock: Socket): i32
{
    let optval: i32 = 1
    return setsockopt(sock.fd, 1, 9, &optval, 4)
}

pub fn set_broadcast(sock: Socket): i32
{
    let optval: i32 = 1
    return setsockopt(sock.fd, 1, 6, &optval, 4)
}

pub fn set_nonblocking(sock: Socket): i32
{
    return fcntl(sock.fd, 4, 2048)
}

pub fn send_udp(sock: Socket, buf: ptr, len: usize, dest: sockaddr_in): isize
{
    return sendto(sock.fd, buf, len, 0, &dest, 16)
}

pub fn recv_udp(sock: Socket, buf: ptr, len: usize, src: ptr): isize
{
    let addrlen: usize = 16
    return recvfrom(sock.fd, buf, len, 0, src, &addrlen)
}

pub fn hostname(): ptr
{
    let buf = malloc(256)
    if (buf == 0)
    {
        return 0
    }
    if (gethostname(buf, 256) < 0)
    {
        free(buf)
        return 0
    }
    return buf
}

pub fn make_addr(ip: string, port: i32): sockaddr_in
{
    let addr = sockaddr_in{ sin_family: 2, sin_port: port, sin_addr: inet_addr(ip) }
    return addr
}

pub fn make_addr_any(port: i32): sockaddr_in
{
    let addr = sockaddr_in{ sin_family: 2, sin_port: port, sin_addr: 0 }
    return addr
}
