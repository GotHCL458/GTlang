extern "C"
{
    fn memset(ptr: ptr, value: i32, num: usize): ptr
    fn memcpy(dest: ptr, src: ptr, num: usize): ptr
    fn memmove(dest: ptr, src: ptr, num: usize): ptr
    fn memcmp(ptr1: ptr, ptr2: ptr, num: usize): i32
    fn malloc(size: usize): ptr
    fn calloc(count: usize, size: usize): ptr
    fn realloc(ptr: ptr, size: usize): ptr
    fn free(ptr: ptr): void
}

pub fn set(ptr: ptr, value: i32, num: usize): ptr
{
    return memset(ptr, value, num)
}

pub fn copy(dest: ptr, src: ptr, num: usize): ptr
{
    return memcpy(dest, src, num)
}

pub fn move(dest: ptr, src: ptr, num: usize): ptr
{
    return memmove(dest, src, num)
}

pub fn compare(ptr1: ptr, ptr2: ptr, num: usize): i32
{
    return memcmp(ptr1, ptr2, num)
}

pub fn zero(ptr: ptr, num: usize): ptr
{
    return memset(ptr, 0, num)
}

pub fn alloc(size: usize): ptr
{
    return malloc(size)
}

pub fn alloc_zeroed(count: usize, size: usize): ptr
{
    return calloc(count, size)
}

pub fn realloc_ptr(ptr: ptr, size: usize): ptr
{
    return realloc(ptr, size)
}

pub fn dealloc(ptr: ptr): void
{
    free(ptr)
}

pub fn dup_mem(src: ptr, size: usize): ptr
{
    if (src == 0 or size == 0)
    {
        return 0
    }
    let dest = malloc(size)
    if (dest == 0)
    {
        return 0
    }
    memcpy(dest, src, size)
    return dest
}

pub fn swap(a: ptr, b: ptr, size: usize)
{
    if (a == 0 or b == 0 or size == 0)
    {
        return
    }
    let tmp = malloc(size)
    if (tmp == 0)
    {
        return
    }
    memcpy(tmp, a, size)
    memcpy(a, b, size)
    memcpy(b, tmp, size)
    free(tmp)
}

pub fn fill_byte(ptr: ptr, value: i32, count: usize): ptr
{
    return memset(ptr, value, count)
}

pub fn mem_equal(a: ptr, b: ptr, size: usize): i32
{
    return memcmp(a, b, size)
}

pub fn min(a: i32, b: i32): i32
{
    if (a < b)
    {
        return a
    }
    return b
}

pub fn max(a: i32, b: i32): i32
{
    if (a > b)
    {
        return a
    }
    return b
}

pub fn clamp(val: i32, lo: i32, hi: i32): i32
{
    if (val < lo)
    {
        return lo
    }
    if (val > hi)
    {
        return hi
    }
    return val
}
