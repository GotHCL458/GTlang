extern "C"
{
    fn system(cmd: ptr): i32
    fn exit(status: i32): void
    fn opendir(path: ptr): ptr
    fn readdir(dir: ptr): ptr
    fn closedir(dir: ptr): i32
    fn getcwd(buf: ptr, size: usize): ptr
    fn chdir(path: ptr): i32
    fn mkdir(path: ptr, mode: u32): i32
    fn rmdir(path: ptr): i32
    fn remove(path: ptr): i32
    fn rename(old: ptr, new: ptr): i32
    fn getenv(name: ptr): ptr
    fn setenv(name: ptr, value: ptr, overwrite: i32): i32
    fn unsetenv(name: ptr): i32
    fn sleep(seconds: u32): u32
    fn usleep(usec: u32): i32
    fn getpid(): i32
    fn getppid(): i32
    fn getuid(): u32
    fn geteuid(): u32
    fn access(path: ptr, mode: i32): i32
    fn stat(path: ptr, buf: ptr): i32
    fn chmod(path: ptr, mode: u32): i32
    fn chown(path: ptr, owner: u32, group: u32): i32
    fn realpath(path: ptr, resolved: ptr): ptr
    fn perror(s: ptr): void
    fn malloc(size: usize): ptr
    fn free(ptr: ptr): void
}

pub fn run(cmd: ptr): i32
{
    return system(cmd)
}

pub fn quit(status: i32): void
{
    exit(status)
}

pub fn open_dir(path: ptr): ptr
{
    return opendir(path)
}

pub fn read_dir(dir: ptr): ptr
{
    return readdir(dir)
}

pub fn close_dir(dir: ptr): i32
{
    return closedir(dir)
}

pub fn current_dir(): ptr
{
    let buf = malloc(1024)
    if (buf == 0)
    {
        return 0
    }
    let result = getcwd(buf, 1024)
    if (result == 0)
    {
        free(buf)
        return 0
    }
    return buf
}

pub fn change_dir(path: ptr): i32
{
    return chdir(path)
}

pub fn make_dir(path: ptr): i32
{
    return mkdir(path, 493)
}

pub fn remove_dir(path: ptr): i32
{
    return rmdir(path)
}

pub fn remove_file(path: ptr): i32
{
    return remove(path)
}

pub fn rename_file(old: ptr, new: ptr): i32
{
    return rename(old, new)
}

pub fn get_env(name: ptr): ptr
{
    return getenv(name)
}

pub fn set_env(name: ptr, value: ptr): i32
{
    return setenv(name, value, 1)
}

pub fn unset_env(name: ptr): i32
{
    return unsetenv(name)
}

pub fn delay(seconds: u32): void
{
    sleep(seconds)
}

pub fn delay_ms(ms: u32): void
{
    usleep(ms * 1000)
}

pub fn delay_us(us: u32): void
{
    usleep(us)
}

pub fn pid(): i32
{
    return getpid()
}

pub fn ppid(): i32
{
    return getppid()
}

pub fn uid(): u32
{
    return getuid()
}

pub fn euid(): u32
{
    return geteuid()
}

pub fn file_exists(path: ptr): i32
{
    if (access(path, 0) == 0)
    {
        return 1
    }
    return 0
}

pub fn file_readable(path: ptr): i32
{
    if (access(path, 4) == 0)
    {
        return 1
    }
    return 0
}

pub fn file_writable(path: ptr): i32
{
    if (access(path, 2) == 0)
    {
        return 1
    }
    return 0
}

pub fn file_executable(path: ptr): i32
{
    if (access(path, 1) == 0)
    {
        return 1
    }
    return 0
}

pub fn set_permissions(path: ptr, mode: u32): i32
{
    return chmod(path, mode)
}

pub fn set_owner(path: ptr, owner: u32, group: u32): i32
{
    return chown(path, owner, group)
}

pub fn abs_path(path: ptr): ptr
{
    return realpath(path, 0)
}

pub fn print_error(msg: ptr): void
{
    perror(msg)
}
