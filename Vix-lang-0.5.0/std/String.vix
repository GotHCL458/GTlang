import "mem.vix"

pub type Result:[T, E] = Ok(T) | Err(E)

pub fn length(s: ptr): i32
{
    if (s == 0)
    {
        return 0
    }
    let mut i = 0
    while (s[i] != 0)
    {
        i = i + 1
    }
    return i
}

pub fn strcmp(a: ptr, b: ptr): i32
{
    let mut i = 0
    while (a[i] != 0)
    {
        if (b[i] == 0)
        {
            return 1
        }
        if (a[i] < b[i])
        {
            return -1
        }
        if (a[i] > b[i])
        {
            return 1
        }
        i = i + 1
    }
    if (b[i] != 0)
    {
        return -1
    }
    return 0
}

pub fn equal(a: ptr, b: ptr): i32
{
    if (strcmp(a, b) == 0)
    {
        return 1
    }
    return 0
}

pub fn strconnect(a: ptr, b: ptr): ?ptr
{
    let mut i = 0
    let mut j = 0
    let mut result = malloc(a.length + b.length + 1)
    if (result == 0)
    {
        return None
    }
    while (a[i] != 0)
    {
        result[j] = a[i]
        i = i + 1
        j = j + 1
    }
    i = 0
    while (b[i] != 0)
    {
        result[j] = b[i]
        i = i + 1
        j = j + 1
    }
    result[j] = 0
    return Some(result)
}

pub fn new_string(src: ptr, len: usize): Result:[ptr, ptr]
{
    if (src == 0)
    {
        return Err("Source string is null")
    }
    let dest = malloc(len + 1)
    if (dest == 0)
    {
        return Err("Out of memory")
    }
    copy(dest, src, len)
    for (i in 0 .. len)
    {
        if (dest[i] == 0)
        {
            return Err("Source string is shorter than specified length")
        }
    }
    dest[len] = 0
    return Ok(dest)
}

pub fn dup(s: ptr): ?ptr
{
    if (s == 0)
    {
        return None
    }
    let len = length(s)
    let result = malloc(len + 1)
    if (result == 0)
    {
        return None
    }
    copy(result, s, len + 1)
    return Some(result)
}

pub fn char_at(s: ptr, index: i32): i32
{
    if (s == 0 or index < 0)
    {
        return 0
    }
    return s[index]
}

pub fn contains(haystack: ptr, needle: ptr): i32
{
    if (haystack == 0 or needle == 0)
    {
        return 0
    }
    let hlen = length(haystack)
    let nlen = length(needle)
    if (nlen == 0)
    {
        return 1
    }
    if (nlen > hlen)
    {
        return 0
    }
    for (i in 0 .. hlen - nlen + 1)
    {
        let mut found = 1
        for (j in 0 .. nlen)
        {
            if (haystack[i + j] != needle[j])
            {
                found = 0
            }
        }
        if (found == 1)
        {
            return 1
        }
    }
    return 0
}

pub fn starts_with(s: ptr, prefix: ptr): i32
{
    if (s == 0 or prefix == 0)
    {
        return 0
    }
    let mut i = 0
    while (prefix[i] != 0)
    {
        if (s[i] == 0)
        {
            return 0
        }
        if (s[i] != prefix[i])
        {
            return 0
        }
        i = i + 1
    }
    return 1
}

pub fn ends_with(s: ptr, suffix: ptr): i32
{
    if (s == 0 or suffix == 0)
    {
        return 0
    }
    let slen = length(s)
    let suflen = length(suffix)
    if (suflen > slen)
    {
        return 0
    }
    let offset = slen - suflen
    for (i in 0 .. suflen)
    {
        if (s[offset + i] != suffix[i])
        {
            return 0
        }
    }
    return 1
}

pub fn index_of(haystack: ptr, needle: ptr): i32
{
    if (haystack == 0 or needle == 0)
    {
        return -1
    }
    let hlen = length(haystack)
    let nlen = length(needle)
    if (nlen == 0)
    {
        return 0
    }
    if (nlen > hlen)
    {
        return -1
    }
    for (i in 0 .. hlen - nlen + 1)
    {
        let mut found = 1
        for (j in 0 .. nlen)
        {
            if (haystack[i + j] != needle[j])
            {
                found = 0
            }
        }
        if (found == 1)
        {
            return i
        }
    }
    return -1
}

pub fn substring(s: ptr, start: i32, end: i32): ?ptr
{
    if (s == 0 or start < 0 or end < start)
    {
        return None
    }
    let len = end - start
    let result = malloc(len + 1)
    if (result == 0)
    {
        return None
    }
    for (i in 0 .. len)
    {
        result[i] = s[start + i]
    }
    result[len] = 0
    return Some(result)
}

pub fn to_upper(s: ptr): ?ptr
{
    if (s == 0)
    {
        return None
    }
    let len = length(s)
    let result = malloc(len + 1)
    if (result == 0)
    {
        return None
    }
    for (i in 0 .. len)
    {
        let c = s[i]
        if (c >= 'a' and c <= 'z')
        {
            result[i] = c - 32
        }
        else
        {
            result[i] = c
        }
    }
    result[len] = 0
    return Some(result)
}

pub fn to_lower(s: ptr): ?ptr
{
    if (s == 0)
    {
        return None
    }
    let len = length(s)
    let result = malloc(len + 1)
    if (result == 0)
    {
        return None
    }
    for (i in 0 .. len)
    {
        let c = s[i]
        if (c >= 'A' and c <= 'Z')
        {
            result[i] = c + 32
        }
        else
        {
            result[i] = c
        }
    }
    result[len] = 0
    return Some(result)
}

pub fn trim(s: ptr): ?ptr
{
    if (s == 0)
    {
        return None
    }
    let len = length(s)
    let mut start = 0
    let mut end = len - 1
    while (start < len and (s[start] == ' ' or s[start] == '\t' or s[start] == '\n' or s[start] == '\r'))
    {
        start = start + 1
    }
    while (end >= start and (s[end] == ' ' or s[end] == '\t' or s[end] == '\n' or s[end] == '\r'))
    {
        end = end - 1
    }
    let new_len = end - start + 1
    if (new_len <= 0)
    {
        let result = malloc(1)
        result[0] = 0
        return Some(result)
    }
    return substring(s, start, end + 1)
}

pub fn reverse(s: ptr): ?ptr
{
    if (s == 0)
    {
        return None
    }
    let len = length(s)
    let result = malloc(len + 1)
    if (result == 0)
    {
        return None
    }
    for (i in 0 .. len)
    {
        result[i] = s[len - 1 - i]
    }
    result[len] = 0
    return Some(result)
}

pub fn repeat(s: ptr, count: i32): ?ptr
{
    if (s == 0 or count <= 0)
    {
        return None
    }
    let slen = length(s)
    let total = slen * count
    let result = malloc(total + 1)
    if (result == 0)
    {
        return None
    }
    let mut pos = 0
    for (i in 0 .. count)
    {
        for (j in 0 .. slen)
        {
            result[pos] = s[j]
            pos = pos + 1
        }
    }
    result[total] = 0
    return Some(result)
}

pub fn replace(s: ptr, old: ptr, new: ptr): ?ptr
{
    if (s == 0 or old == 0 or new == 0)
    {
        return None
    }
    let idx = index_of(s, old)
    if (idx < 0)
    {
        return dup(s)
    }
    let slen = length(s)
    let olen = length(old)
    let nlen = length(new)
    let result_len = slen - olen + nlen
    let result = malloc(result_len + 1)
    if (result == 0)
    {
        return None
    }
    let mut pos = 0
    for (i in 0 .. idx)
    {
        result[pos] = s[i]
        pos = pos + 1
    }
    for (i in 0 .. nlen)
    {
        result[pos] = new[i]
        pos = pos + 1
    }
    for (i in idx + olen .. slen)
    {
        result[pos] = s[i]
        pos = pos + 1
    }
    result[result_len] = 0
    return Some(result)
}

pub fn count_char(s: ptr, c: i32): i32
{
    if (s == 0)
    {
        return 0
    }
    let mut count = 0
    let mut i = 0
    while (s[i] != 0)
    {
        if (s[i] == c)
        {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

pub fn count_substr(s: ptr, needle: ptr): i32
{
    if (s == 0 or needle == 0)
    {
        return 0
    }
    let nlen = length(needle)
    if (nlen == 0)
    {
        return 0
    }
    let mut count = 0
    let mut pos = 0
    let slen = length(s)
    while (pos <= slen - nlen)
    {
        let mut found = 1
        for (j in 0 .. nlen)
        {
            if (s[pos + j] != needle[j])
            {
                found = 0
            }
        }
        if (found == 1)
        {
            count = count + 1
            pos = pos + nlen
        }
        else
        {
            pos = pos + 1
        }
    }
    return count
}

pub fn is_empty(s: ptr): bool
{
    if (s == 0 or s[0] == 0)
    {
        return true
    }
    return 0
}
impl String
{
    pub fn length(self: ptr): i32
    {
        return length(self)
    }
    pub fn char_at(self: ptr, index: i32): i32
    {
        return char_at(self, index)
    }
    pub fn contains(self: ptr, needle: ptr): i32
    {
        return contains(self, needle)
    }
    pub fn starts_with(self: ptr, prefix: ptr): i32
    {
        return starts_with(self, prefix)
    }
    pub fn ends_with(self: ptr, suffix: ptr): i32
    {
        return ends_with(self, suffix)
    }
    pub fn index_of(self: ptr, needle: ptr): i32
    {
        return index_of(self, needle)
    }
}