extern "C"
{
    fn printf(format: ptr, ...): i32
}
fn strcmp(a: ptr, b: ptr): i32
{
    let mut i = 0
    while (1)
    {
        let ca = a[i]
        let cb = b[i]
        if (ca != cb)
        {
            return ca - cb
        }
        if (ca == 0)
        {
            return 0
        }
        i += 1
    }
    return 0
}
fn main(): i32
{
    return 0
}