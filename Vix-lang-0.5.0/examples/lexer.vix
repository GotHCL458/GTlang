fn lexer(s: string): i32 {
    for (i in 0 .. s.length) {
        let c = s[i]
        if (c == ' ') {
            continue
        }
        elif (c >= '0' and c <= '9') {
            print("Number")
        }
        elif (c == '+' or c == '-' or c == '*' or c == '/') {
            print("Operator")
        }
        elif (c == '=') {
            print("Equals")
        }
        elif ((c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')) {
            print("Identifier")
        }
        else {
            print("Unknown")
        }
    }
    return 0

}
