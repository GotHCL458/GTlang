type HashMap:[V] = struct
{
	buckets: [ [ (string, V) ] ]
	size: i32
}
type Option:[T] = Some(T) | None
fn nor_cap(capacity: i32): i32
{
	if (capacity <= 0)
    { 
        return 16
    }
	return capacity
}

fn hash_str(s: string): i32
{
	let mut hash: i32 = 5381
	let mut i = 0
	while (i < s.length)
	{
		hash = (hash * 33) + s[i]
		i = i + 1
	}
	if (hash < 0)
    {
        hash = -hash
    }
	return hash
}

fn bucket_index(key: string, capacity: i32): i32
{
	let mut h = hash_str(key)
	if (h < 0)
    {
        h = -h 
    }
	return h % capacity
}

pub fn new_hashmap:[V](capacity: i32): HashMap:[V]
{
	let cap = nor_cap(capacity)
	let buckets: [ [ (string, V) ] ] = []
	let mut i = 0
	while (i < cap)
	{
		buckets.push([])
		i = i + 1
	}
	return HashMap:[V]{ buckets: buckets, size: 0 }
}
pub fn len:[V](map: HashMap:[V]): i32
{
	return map.size
}

pub fn capacity:[V](map: HashMap:[V]): i32
{
	return map.buckets.length
}
fn main(): i32
{
	let h = hash_str("hi")
	print(h)
	let idx = bucket_index("hello", 16)
	print(idx)
	return 0    
}
