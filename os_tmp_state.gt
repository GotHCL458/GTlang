enum State { Idle, Running(int), Done(str), Failed(str, int) }
fn describe(s: State) -> str {
    match s {
        State::Idle => { return "idle" }
        State::Running(n) => { return "running: " + str(n) }
        State::Done(msg) => { return "done: " + msg }
        State::Failed(msg, code) => { return "failed: " + msg + " (" + str(code) + ")" }
    }
}
fn main() {
    states := list()
    push(states, State::Idle)
    push(states, State::Running(42))
    push(states, State::Done("ok"))
    push(states, State::Failed("err", 500))
    for s in states { put(describe(s)) }
}
