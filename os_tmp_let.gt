fn get(o: Option[Option[int]]) -> Option[int] {
    if let Some(inner) = o {
        return inner
    }
    return None
}
fn main() {
    put(get(Some(Some(5))))
    put(get(Some(None)))
    put(get(None))
    // while let
    xs := list()
    push(xs, 1)
    push(xs, 2)
    push(xs, 3)
    total := 0
    i := 0
    while i < len(xs) {
        if let Some(v) = Some(xs[i]) { total = total + v }
        i = i + 1
    }
    put(total)
}
